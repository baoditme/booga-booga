-- =============================================
-- THEME SYSTEM (FIX: dọn màu cũ + KHÔNG tô Head)
-- =============================================
SettingsTab:CreateSection("GUI Theme")

local themeAnimationRunning = false
local themeRenderConn = nil
local backedUpFrames = {}
local originalMainColor = nil
local originalMainTrans = nil
local themedMain = nil

local function findRayfieldMain()
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
    for _, gui in ipairs(guiParent:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():find("rayfield") or gui:FindFirstChild("Main")) then
            local main = gui:FindFirstChild("Main")
            if main then return main end
            for _, child in ipairs(gui:GetDescendants()) do
                if child:IsA("Frame") and child.Name == "Main" then
                    return child
                end
            end
        end
    end
    return nil
end

local bodyNames = {
    ["TabList"] = true,
    ["Elements"] = true,
    ["Container"] = true,
    ["Navigation"] = true,
    ["Sidebar"] = true,
    ["Content"] = true,
    ["Inner"] = true,
    ["Page"] = true,
    ["Pages"] = true,
}

local headNames = {
    ["Topbar"] = true,
    ["Header"] = true,
    ["Title"] = true,
    ["Top"] = true,
}

local function isUnderHead(obj, main)
    local p = obj
    while p and p ~= main do
        if headNames[p.Name] then
            return true
        end
        p = p.Parent
    end
    return false
end

local function stopThemeAnimation()
    themeAnimationRunning = false
    if themeRenderConn then
        themeRenderConn:Disconnect()
        themeRenderConn = nil
    end
end

local function clearGradient(main)
    if not main then return end
    local g = main:FindFirstChild("RayfieldThemeGradient")
    if g then g:Destroy() end
end

local function restoreOriginalProperties()
    stopThemeAnimation()

    local main = themedMain or findRayfieldMain()
    if main then
        clearGradient(main)
        if originalMainColor ~= nil then
            main.BackgroundColor3 = originalMainColor
        end
        if originalMainTrans ~= nil then
            main.BackgroundTransparency = originalMainTrans
        end
    end

    for _, data in ipairs(backedUpFrames) do
        if data.frame and data.frame.Parent then
            data.frame.BackgroundColor3 = data.color
            data.frame.BackgroundTransparency = data.trans
        end
    end

    table.clear(backedUpFrames)
    originalMainColor = nil
    originalMainTrans = nil
    themedMain = nil
end

local function prepareBodyForTheme(main)
    restoreOriginalProperties()

    themedMain = main
    originalMainColor = main.BackgroundColor3
    originalMainTrans = main.BackgroundTransparency

    main.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    main.BackgroundTransparency = 0

    for _, child in ipairs(main:GetDescendants()) do
        if child:IsA("GuiObject") then
            if isUnderHead(child, main) then
                -- Bỏ qua phần Head
            elseif bodyNames[child.Name] or (child:IsA("Frame") and child.BackgroundTransparency < 1 and child ~= main) then
                if bodyNames[child.Name] then
                    table.insert(backedUpFrames, {
                        frame = child,
                        color = child.BackgroundColor3,
                        trans = child.BackgroundTransparency
                    })
                    child.BackgroundTransparency = 0.92
                end
            end
        end
    end

    if #backedUpFrames == 0 then
        for _, child in ipairs(main:GetChildren()) do
            if child:IsA("GuiObject") and not headNames[child.Name] then
                table.insert(backedUpFrames, {
                    frame = child,
                    color = child.BackgroundColor3,
                    trans = child.BackgroundTransparency
                })
                if child:IsA("Frame") then
                    child.BackgroundTransparency = 0.92
                end
            end
        end
    end

    local gradient = Instance.new("UIGradient")
    gradient.Name = "RayfieldThemeGradient"
    gradient.Parent = main
    return gradient
end

local function createScrollingGradient(colors, offset)
    local keypoints = {}
    local numColors = #colors
    for i = 0, 12 do
        local pos = i / 12
        local samplePoint = (pos - offset) % 1
        local exactIdx = samplePoint * numColors
        local idx1 = math.floor(exactIdx) + 1
        local idx2 = idx1 + 1
        local frac = exactIdx - math.floor(exactIdx)
        local c1 = colors[((idx1 - 1) % numColors) + 1]
        local c2 = colors[((idx2 - 1) % numColors) + 1]
        table.insert(keypoints, ColorSequenceKeypoint.new(pos, c1:Lerp(c2, frac)))
    end
    return ColorSequence.new(keypoints)
end

local function applyTheme1(main)
    local gradient = prepareBodyForTheme(main)
    gradient.Rotation = 90
    local colors = {
        Color3.fromRGB(20, 120, 255),
        Color3.fromRGB(10, 50, 140),
        Color3.fromRGB(5, 10, 25)
    }
    themeAnimationRunning = true
    themeRenderConn = RunService.RenderStepped:Connect(function()
        if not themeAnimationRunning then return end
        local offset = (tick() * 0.12) % 1
        gradient.Color = createScrollingGradient(colors, offset)
        gradient.Offset = Vector2.new(0, 0)
    end)
end

local function applyTheme2(main)
    local gradient = prepareBodyForTheme(main)
    gradient.Rotation = 90
    local colors = {
        Color3.fromRGB(220, 30, 30),
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(160, 20, 20)
    }
    themeAnimationRunning = true
    themeRenderConn = RunService.RenderStepped:Connect(function()
        if not themeAnimationRunning then return end
        local offset = (tick() * 0.12) % 1
        gradient.Color = createScrollingGradient(colors, offset)
        gradient.Offset = Vector2.new(0, 0)
    end)
end

local function applyTheme3(main)
    restoreOriginalProperties()
end

local function applyTheme4(main)
    local gradient = prepareBodyForTheme(main)
    gradient.Rotation = 45
    themeAnimationRunning = true
    themeRenderConn = RunService.RenderStepped:Connect(function()
        if not themeAnimationRunning then return end
        local offset = tick() * 0.12
        local keypoints = {}
        for i = 0, 12 do
            local pos = i / 12
            local hue = (pos - offset) % 1
            if hue < 0 then hue = hue + 1 end
            table.insert(keypoints, ColorSequenceKeypoint.new(pos, Color3.fromHSV(hue, 1, 1)))
        end
        gradient.Color = ColorSequence.new(keypoints)
        gradient.Offset = Vector2.new(0, 0)
    end)
end

local themeNames = {
    "1. Ocean Blue (Xanh -> Den)",
    "2. Red & White (Do & Trang)",
    "3. Default (Mac dinh)",
    "4. Rainbow (Cau vong)"
}
local selectedThemeName = "3. Default (Mac dinh)"

local function applySelectedTheme(themeName)
    local mainFrame = findRayfieldMain()
    if not mainFrame then
        Notify{ Title = "Theme", Content = "Cannot find Rayfield Main", Duration = 3 }
        return
    end

    stopThemeAnimation()

    if themeName == themeNames[1] then
        applyTheme1(mainFrame)
    elseif themeName == themeNames[2] then
        applyTheme2(mainFrame)
    elseif themeName == themeNames[3] then
        applyTheme3(mainFrame)
    elseif themeName == themeNames[4] then
        applyTheme4(mainFrame)
    end

    Notify{ Title = "Theme", Content = "Applied: " .. tostring(themeName), Duration = 2 }
end

SettingsTab:CreateDropdown({
    Name = "Select GUI Theme",
    Options = themeNames,
    CurrentValue = "3. Default (Mac dinh)",
    MultiSelect = false,
    Flag = "guiThemeDropdown",
    Callback = function(value)
        if type(value) == "table" then
            selectedThemeName = value[1] or themeNames[3]
        else
            selectedThemeName = value
        end
        applySelectedTheme(selectedThemeName)
    end
})

SettingsTab:CreateButton({
    Name = "Refresh Theme (Apply Again)",
    Callback = function()
        applySelectedTheme(selectedThemeName)
    end
})

