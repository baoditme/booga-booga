local foodDropdownNames = {}
local foodNameToData = {}
for _, food in ipairs(foodList) do
    table.insert(foodDropdownNames, food.name)
    foodNameToData[food.name] = food
end

local autoEatEnabled = false
local autoEatTask = nil
local selectedFood = "Cooked Meat"
local hungerThreshold = 80

local function getHungerValue()
    local success, result = pcall(function()
        local mainGui = LocalPlayer.PlayerGui:FindFirstChild("MainGui")
        if not mainGui then return nil end
        local panels = mainGui:FindFirstChild("Panels")
        if not panels then return nil end
        local stats = panels:FindFirstChild("Stats")
        if not stats then return nil end
        local bars = stats:FindFirstChild("Bars")
        if not bars then return nil end
        local hunger = bars:FindFirstChild("Hunger")
        if not hunger then return nil end
        local valueLabel = hunger:FindFirstChild("ValueLabel")
        if not valueLabel then return nil end

        local text = valueLabel.Text
        local cleaned = text:match("([%d%.]+)")
        if cleaned then
            return tonumber(cleaned)
        end
        return nil
    end)

    if success then return result end
    return nil
end

local function getFoodLayoutOrder(foodName)
    local success, result = pcall(function()
        local mainGui = LocalPlayer.PlayerGui:FindFirstChild("MainGui")
        if not mainGui then return nil end
        local rightPanel = mainGui:FindFirstChild("RightPanel")
        if not rightPanel then return nil end
        local inventory = rightPanel:FindFirstChild("Inventory")
        if not inventory then return nil end
        local list = inventory:FindFirstChild("List")
        if not list then return nil end

        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("ImageLabel") and child.Name == foodName then
                return child.LayoutOrder
            end
        end
        return nil
    end)

    if success then return result end
    return nil
end

local function createEatBuffer(layoutOrder)
    local bytes = { 0, OPCODES.EAT, layoutOrder, 0 }
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end

local function sendEat(layoutOrder)
    local event = getByteNetRemote()
    if not event then return false end
    local bufferData = createEatBuffer(layoutOrder)
    pcall(function() event:FireServer(bufferData, nil) end)
    return true
end

local function autoEatLoop()
    while autoEatEnabled do
        local hungerVal = getHungerValue()

        if hungerVal and hungerVal <= hungerThreshold then
            local layoutOrder = getFoodLayoutOrder(selectedFood)
            if layoutOrder then
                sendEat(layoutOrder)
            end
        end

        task.wait(1)
    end
end

AutoFarmTab:CreateDropdown({
    Name = "Select Food",
    Options = foodDropdownNames,
    CurrentValue = "Cooked Meat",
    MultiSelect = false,
    Flag = "foodDropdown",
    Callback = function(value)
        if type(value) == "table" then
            selectedFood = value[1] or "Cooked Meat"
        else
            selectedFood = value
        end
    end
})

AutoFarmTab:CreateSlider({
    Name = "Hunger Threshold",
    Range = {0, 100},
    Increment = 1,
    Suffix = "%",
    CurrentValue = 80,
    Flag = "hungerThresholdSlider",
    Callback = function(v)
        hungerThreshold = v
    end
})

local autoEatToggleObj
autoEatToggleObj = AutoFarmTab:CreateToggle({
    Name = "Auto Eat",
    CurrentValue = false,
    Flag = "autoEatToggle",
    Callback = function(v)
        autoEatEnabled = v
        if autoEatTask then task.cancel(autoEatTask); autoEatTask = nil end

        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Eat", Content = "Disabled", Duration = 2 }
                autoEatToggleObj:Set(false)
                return
            end

            local layoutOrder = getFoodLayoutOrder(selectedFood)
            if not layoutOrder then
                Notify{ Title = "Auto Eat", Content = "Disabled", Duration = 2 }
                autoEatToggleObj:Set(false)
                return
            end

            autoEatTask = task.spawn(autoEatLoop)
            Notify{ Title = "Auto Eat", Content = "Enabled", Duration = 2 }
        else
            Notify{ Title = "Auto Eat", Content = "Disabled", Duration = 2 }
        end
    end
})

