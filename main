SettingsTab:CreateSection("Configuration")

local function buildConfigTable()
    return {
        warningToggle = warningEnabled,
        hitboxToggle = hitboxActive,
        autoHealToggle = autoHealEnabled,
        autoHealV2Toggle = autoHealV2Enabled,
        healFireInterval = healFireInterval,
        espToggle = espEnabled,
        espTeamColor = espTeamColorEnabled,
        espGodToggle = espGodEnabled,
        espOreToggle = espOreEnabled,
        selectedOres = selectedOres,
        autoChunkToggle = autoChunkEnabled,
        chunkDistance = chunkDistance,
        autoClickToggle = autoClickEnabled,
        clickPosition = clickPositionMode,
        autoClickInterval = autoClickInterval,
        autoClickHotkey = autoClickHotkey.Name,
        autoPickupToggle = autoPickupEnabled,
        autoPickupInterval = autoPickupInterval,
        pickFruitToggle = pickFruitEnabled,
        pickFruitRange = pickFruitRange,
        selectedFruit = selectedFruit,
        plantFruitToggle = plantFruitEnabled,
        plantFruitRange = plantFruitRange,
        fruitTweenToggle = fruitTweenEnabled,
        autoEatToggle = autoEatEnabled,
        selectedFood = selectedFood,
        hungerThreshold = hungerThreshold,
        fullbrightToggle = fullbrightEnabled,
        noFogToggle = noFogEnabled,
        speedToggle = speedEnabled,
        speedValue = speedValue,
        climbToggle = climbEnabled,
        gravityToggle = gravityEnabled,
        gravityValue = gravityValue,
        zoomToggle = zoomEnabled,
        muteNotifications = not notifyEnabled,
        guiTheme = selectedThemeName,
        autoHutToggle = autoHutEnabled,
        autoHutDistance = autoHutDistance,
    }
end

local function applyConfigValues(config)
    if config.speedValue then speedValue = config.speedValue end
    if config.gravityValue then gravityValue = config.gravityValue end
    if config.chunkDistance then chunkDistance = config.chunkDistance end
    if config.pickFruitRange then pickFruitRange = config.pickFruitRange end
    if config.plantFruitRange then plantFruitRange = config.plantFruitRange end
    if config.hungerThreshold then hungerThreshold = config.hungerThreshold end
    if config.selectedFruit then selectedFruit = config.selectedFruit end
    if config.selectedFood then selectedFood = config.selectedFood end
    if config.clickPosition then clickPositionMode = config.clickPosition end
    if config.selectedOres then selectedOres = config.selectedOres end
    if config.autoClickInterval then autoClickInterval = config.autoClickInterval end
    if config.autoPickupInterval then autoPickupInterval = math.clamp(tonumber(config.autoPickupInterval) or 0.05, 0.01, 1) end
    if config.healFireInterval then healFireInterval = math.clamp(tonumber(config.healFireInterval) or 0.1, 0.01, 1) end

    if config.autoClickHotkey then
        local keyOk, keyVal = pcall(function() return Enum.KeyCode[config.autoClickHotkey] end)
        if keyOk and keyVal then
            autoClickHotkey = keyVal
            pcall(function() hotkeyButtonObj:Set("Auto Click Hotkey: " .. autoClickHotkey.Name .. " (Click to change)") end)
        end
    end

    if config.muteNotifications ~= nil then notifyEnabled = not config.muteNotifications end

    if config.guiTheme then
        selectedThemeName = config.guiTheme
        task.spawn(function()
            task.wait(1.5)
            applySelectedTheme(selectedThemeName)
        end)
    end

    if config.autoHutDistance then autoHutDistance = config.autoHutDistance end

    local flagValues = {
        warningToggle = config.warningToggle,
        hitboxToggle = config.hitboxToggle,
        autoHealToggle = config.autoHealToggle,
        autoHealV2Toggle = config.autoHealV2Toggle,
        espToggle = config.espToggle,
        espTeamColor = config.espTeamColor,
        espGodToggle = config.espGodToggle,
        espOreToggle = config.espOreToggle,
        espTraderToggle = config.espTraderToggle,
        oreDropdown = config.selectedOres,
        autoChunkToggle = config.autoChunkToggle,
        chunkDistanceSlider = config.chunkDistance,
        autoClickToggle = config.autoClickToggle,
        clickPositionDropdown = config.clickPosition,
        clickSpeedSlider = config.autoClickInterval,
        autoPickupToggle = config.autoPickupToggle,
        autoPickupIntervalSlider = config.autoPickupInterval,
        pickFruitToggle = config.pickFruitToggle,
        pickFruitRangeSlider = config.pickFruitRange,
        fruitDropdown = config.selectedFruit,
        plantFruitToggle = config.plantFruitToggle,
        plantFruitRangeSlider = config.plantFruitRange,
        fruitTweenToggle = config.fruitTweenToggle,
        autoEatToggle = config.autoEatToggle,
        foodDropdown = config.selectedFood,
        hungerThresholdSlider = config.hungerThreshold,
        fullbrightToggle = config.fullbrightToggle,
        noFogToggle = config.noFogToggle,
        speedToggle = config.speedToggle,
        speedSlider = config.speedValue,
        climbToggle = config.climbToggle,
        gravityToggle = config.gravityToggle,
        gravitySlider = config.gravityValue,
        zoomToggle = config.zoomToggle,
        muteNotifications = config.muteNotifications,
        healFireIntervalSlider = config.healFireInterval,
        guiThemeDropdown = config.guiTheme,
        autoHutToggle = config.autoHutToggle,
        autoHutDistanceSlider = config.autoHutDistance,
    }

    for flag, value in pairs(flagValues) do
        if value ~= nil then
            pcall(function()
                if Rayfield.Flags and Rayfield.Flags[flag] and Rayfield.Flags[flag].Set then
                    Rayfield.Flags[flag]:Set(value)
                end
            end)
        end
    end
end

SettingsTab:CreateButton({
    Name = "Save Current Config",
    Callback = function()
        local success, encoded = pcall(function() return HttpService:JSONEncode(buildConfigTable()) end)
        if success then
            if writefile then
                pcall(function() writefile("BoogaToolsPro_SavedConfig.json", encoded) end)
                Notify{ Title = "Config", Content = "Saved successfully", Duration = 2 }
            end
        end
    end
})

SettingsTab:CreateButton({
    Name = "Load Saved Config",
    Callback = function()
        if not readfile or not isfile or not isfile("BoogaToolsPro_SavedConfig.json") then return end
        local success, config = pcall(function()
            local raw = readfile("BoogaToolsPro_SavedConfig.json")
            return HttpService:JSONDecode(raw)
        end)
        if success and config then
            applyConfigValues(config)
            Notify{ Title = "Config", Content = "Loaded successfully", Duration = 2 }
        end
    end
})

SettingsTab:CreateButton({
    Name = "Delete Saved Config",
    Callback = function()
        if delfile and isfile and isfile("BoogaToolsPro_SavedConfig.json") then
            pcall(function() delfile("BoogaToolsPro_SavedConfig.json") end)
            Notify{ Title = "Config", Content = "Deleted", Duration = 2 }
        end
    end
})

SettingsTab:CreateSection("Cleanup")

SettingsTab:CreateButton({
    Name = "Destroy GUI and Cleanup",
    Callback = function()
        pcall(function()
            if writefile then writefile("BoogaToolsPro_SavedConfig.json", HttpService:JSONEncode(buildConfigTable())) end
        end)

        if hitboxLoop then hitboxLoop:Disconnect() end
        if warningLoop then warningLoop:Disconnect() end
        if fbCon then fbCon:Disconnect() end
        if fogCon then fogCon:Disconnect() end
        if speedCon then speedCon:Disconnect() end
        if climbCon then climbCon:Disconnect() end
        if gravityCon then gravityCon:Disconnect() end
        if zoomCon then zoomCon:Disconnect() end
        if playerRenderConn then playerRenderConn:Disconnect() end
        if godRenderConn then godRenderConn:Disconnect() end
        if oreRenderConn then oreRenderConn:Disconnect() end

        if healTask then task.cancel(healTask) end
        if healV2Task then task.cancel(healV2Task) end
        if chunkMonitorTask then task.cancel(chunkMonitorTask) end
        if clickTask then task.cancel(clickTask) end
        if pickupTask then task.cancel(pickupTask) end
        if pickFruitTask then task.cancel(pickFruitTask) end
        if plantFruitTask then task.cancel(plantFruitTask) end
        if autoEatTask then task.cancel(autoEatTask) end
        if fruitTweenTask then task.cancel(fruitTweenTask) end
        if fruitTweenObj then fruitTweenObj:Cancel() end
        if autoHutTask then task.cancel(autoHutTask) end

        if warningSound then warningSound:Stop() end
        if currentTween then currentTween:Cancel() end
        if traderRenderConn then traderRenderConn:Disconnect() end
clearTraderESP()
        destroyZone()
        removeClickDot()
        
        restoreOriginalProperties()

        clearAllPlayerBillboards()
        clearAllGodBillboards()
        clearAllOreBillboards()
        
        if hum then hum.WalkSpeed = 16 hum.MaxSlopeAngle = 46 end
        Workspace.Gravity = 196.2
        Lighting.Brightness = 0.5
        Lighting.Ambient = Color3.fromRGB(127,127,127)
        Lighting.FogEnd = 1000
        Lighting.FogStart = 0
        pcall(function() LocalPlayer.CameraMaxZoomDistance = 400 LocalPlayer.CameraMinZoomDistance = 1 end)

        Notify{ Title = "Cleanup", Content = "Complete", Duration = 2 }
        task.wait(1)
        Rayfield:Destroy()
    end
})

-- =============================================
-- CHARACTER RESET HANDLER & AUTO LOAD
-- =============================================
LocalPlayer.CharacterAdded:Connect(function(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    if speedEnabled then hum.WalkSpeed = speedValue end
    if climbEnabled then hum.MaxSlopeAngle = 90 end
end)

task.spawn(function()
    task.wait(1)

    if not readfile or not isfile then return end
    if not isfile("BoogaToolsPro_SavedConfig.json") then return end

    local success, config = pcall(function()
        local raw = readfile("BoogaToolsPro_SavedConfig.json")
        return HttpService:JSONDecode(raw)
    end)

    if not success or not config then return end

    applyConfigValues(config)
    Notify{ Title = "Config", Content = "Previous settings restored", Duration = 3 }
end)

Notify{
    Title = "Booga Tools Pro",
    Content = "Loaded successfully",
    Duration = 4
}
