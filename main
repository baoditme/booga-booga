local CombatTab = Window:AddTab({ Title = "Combat", Icon = "crosshair" })

-- =============================================
-- CẢNH BÁO 100 STUD
-- =============================================
local warningToggle = CombatTab:CreateToggle("warningToggle", { Title = "🔔 Cảnh báo 100 stud (có âm thanh)", Default = false })
local warningLoop
local lastWarningTime = 0
local warningSound = nil

local function createWarningSound()
    if not warningSound then
        warningSound = Instance.new("Sound")
        warningSound.Name = "WarningSound"
        warningSound.SoundId = "rbxassetid://9126397040"
        warningSound.Volume = 0.5
        warningSound.Parent = Workspace
    end
end

warningToggle:OnChanged(function(v)
    if warningLoop then warningLoop:Disconnect() end
    if v then
        createWarningSound()
        warningLoop = RunService.Heartbeat:Connect(function()
            if not LocalPlayer.Character then return end
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local warnPlayers = {}
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    if isSameTeam(player) then continue end
                    local char = player.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local dist = (root.Position - hrp.Position).Magnitude
                            if dist <= 100 then
                                table.insert(warnPlayers, {Name = player.Name, Dist = math.floor(dist)})
                            end
                        end
                    end
                end
            end
            if #warnPlayers > 0 and os.time() - lastWarningTime >= 5 then
                local names = ""
                for i, p in ipairs(warnPlayers) do
                    names = names .. p.Name .. " (" .. p.Dist .. "m) "
                    if i >= 3 then
                        names = names .. "và " .. (#warnPlayers - i) .. " người khác"
                        break
                    end
                end
                Notify{
                    Title = "🔴 CẢNH BÁO!",
                    Content = "Có " .. #warnPlayers .. " người trong bán kính 100 stud!\n" .. names,
                    Duration = 5
                }
                lastWarningTime = os.time()
                if warningSound then
                    warningSound:Stop()
                    warningSound:Play()
                end
            end
        end)
        Notify{ Title = "🔔 Cảnh báo 100 stud", Content = "Đã bật!", Duration = 2 }
    else
        if warningSound then
            warningSound:Stop()
        end
        Notify{ Title = "🔔 Cảnh báo 100 stud", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- HITBOX ĐỘNG
-- =============================================
local hitboxToggle = CombatTab:CreateToggle("hitboxToggle", { Title = "🔴 Hitbox động (theo khoảng cách)", Default = false })
local hitboxLoop = nil
local hitboxFullSize = Vector3.new(15, 15, 15)
local hitboxDefaultSize = Vector3.new(2, 1, 1)

local function updateHitbox()
    if not hitboxToggle.Value then return end
    if not LocalPlayer.Character then return end
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if isSameTeam(player) then continue end
            local char = player.Character
            if char then
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local dist = (rootPart.Position - localRoot.Position).Magnitude
                    local size
                    if dist >= 10 then
                        size = hitboxFullSize
                    elseif dist <= 5 then
                        size = hitboxDefaultSize
                    else
                        local t = (dist - 5) / (10 - 5)
                        size = hitboxDefaultSize + (hitboxFullSize - hitboxDefaultSize) * t
                    end
                    rootPart.Size = size
                    rootPart.Transparency = 0.7
                    rootPart.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    end
end

hitboxToggle:OnChanged(function(v)
    if hitboxLoop then hitboxLoop:Disconnect() end
    if v then
        hitboxLoop = RunService.RenderStepped:Connect(updateHitbox)
        Notify{ Title = "🔴 Hitbox động", Content = "Đã bật! 10 stud = 15, 5 stud = 2.", Duration = 3 }
    else
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        rootPart.Size = hitboxDefaultSize
                        rootPart.Transparency = 0
                        rootPart.Color = Color3.fromRGB(255, 255, 255)
                    end
                end
            end
        end
        Notify{ Title = "🔴 Hitbox động", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- AUTO HEAL V1
-- =============================================
local autoHealToggle = CombatTab:CreateToggle("autoHealToggle", { Title = "❤️ Auto Heal (Bloodfruit - cực nhanh)", Default = false })
local healRunning = false
local healTask = nil

local byteNetRemote = nil
local function getByteNetRemote()
    if not byteNetRemote then
        byteNetRemote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
    end
    return byteNetRemote
end

local function createHealBuffer()
    local bytes = { 0, 67, 17, 0 }
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end

local function sendHeal()
    local event = getByteNetRemote()
    if not event then return false end
    local bufferData = createHealBuffer()
    pcall(function()
        event:FireServer(bufferData, nil)
    end)
    return true
end

local function healLoopFunction()
    while healRunning do
        if not autoHealToggle.Value then
            break
        end
        
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not hum then
            task.wait(0.1)
            continue
        end
        
        if hum.Health < 100 then
            local startTime = tick()
            while healRunning and autoHealToggle.Value and LocalPlayer.Character do
                local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
                if not hum then break end
                
                if hum.Health >= 100 then
                    break
                end
                
                sendHeal()
                task.wait(0.0001)
                
                if tick() - startTime > 2 then
                    break
                end
            end
        end
        
        task.wait(0.1)
    end
end

autoHealToggle:OnChanged(function(v)
    if healTask then
        task.cancel(healTask)
        healTask = nil
    end
    
    if v then
        if not getByteNetRemote() then
            Notify{
                Title = "Lỗi",
                Content = "Không tìm thấy ByteNetReliable!",
                Duration = 5
            }
            autoHealToggle:SetValue(false)
            return
        end
        
        healRunning = true
        healTask = task.spawn(healLoopFunction)
        Notify{ Title = "❤️ Auto Heal", Content = "Đã bật! Spam 10,000 lần/giây.", Duration = 3 }
    else
        healRunning = false
        Notify{ Title = "❤️ Auto Heal", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- AUTO HEAL V2
-- =============================================
local autoHealV2Toggle = CombatTab:CreateToggle("autoHealV2Toggle", { Title = "❤️‍🔥 Auto Heal V2 (gần địch < 7 stud)", Default = false })
local healV2Running = false
local healV2Task = nil

local function healV2LoopFunction()
    while healV2Running do
        if not autoHealV2Toggle.Value then
            break
        end
        
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not hum then
            task.wait(0.1)
            continue
        end
        
        if hum.Health < 100 then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hasEnemy = false
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        if isSameTeam(player) then continue end
                        local char = player.Character
                        if char then
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                local dist = (root.Position - hrp.Position).Magnitude
                                if dist <= 7 then
                                    hasEnemy = true
                                    break
                                end
                            end
                        end
                    end
                end
                if hasEnemy then
                    local startTime = tick()
                    while healV2Running and autoHealV2Toggle.Value and LocalPlayer.Character do
                        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
                        if not hum then break end
                        if hum.Health >= 100 then break end
                        
                        sendHeal()
                        task.wait(0.0001)
                        
                        if tick() - startTime > 2 then
                            break
                        end
                    end
                end
            end
        end
        
        task.wait(0.1)
    end
end

autoHealV2Toggle:OnChanged(function(v)
    if healV2Task then
        task.cancel(healV2Task)
        healV2Task = nil
    end
    
    if v then
        if not getByteNetRemote() then
            Notify{
                Title = "Lỗi",
                Content = "Không tìm thấy ByteNetReliable!",
                Duration = 5
            }
            autoHealV2Toggle:SetValue(false)
            return
        end
        
        healV2Running = true
        healV2Task = task.spawn(healV2LoopFunction)
        Notify{ Title = "❤️‍🔥 Auto Heal V2", Content = "Đã bật! Heal khi gần địch trong 7 stud.", Duration = 3 }
    else
        healV2Running = false
        Notify{ Title = "❤️‍🔥 Auto Heal V2", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- TAB 2: ESP (BILLBOARDGUI, VIỀN, NỀN TRONG SUỐT, MÀU ĐỒNG BỘ)
-- =============================================
local ESPTab = Window:AddTab({ Title = "ESP", Icon = "eye" })

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- =============================================
-- 1. ESP PLAYER
-- =============================================
local espToggle = ESPTab:CreateToggle("espToggle", { Title = "👁️ ESP Player (Tên + Máu + Khoảng cách)", Default = false })
local espUseTeamColor = ESPTab:CreateToggle("espTeamColor", { Title = "🎨 ESP theo màu đội", Default = false })

local playerBillboards = {}
local playerConnections = {}
local playerRenderConn = nil

local function removePlayerBillboard(player)
    local data = playerBillboards[player]
    if data and data.Bill then
        data.Bill:Destroy()
    end
    playerBillboards[player] = nil
    if playerConnections[player] then
        playerConnections[player]:Disconnect()
        playerConnections[player] = nil
    end
end

local function createPlayerBillboard(player)
    if player == LocalPlayer or playerBillboards[player] then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local bill = Instance.new("BillboardGui")
    bill.Name = "PlayerESP"
    bill.Size = UDim2.new(0, 250, 0, 80)
    bill.Adornee = head
    bill.AlwaysOnTop = true
    bill.StudsOffset = Vector3.new(0, 2.5, 0)
    bill.Parent = head

    -- Nền trong suốt
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.Parent = bill

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.35, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.SourceSans
    nameLabel.TextSize = 18
    nameLabel.Parent = bg
    local strokeName = Instance.new("UIStroke")
    strokeName.Thickness = 1.5
    strokeName.Color = Color3.fromRGB(0, 0, 0)
    strokeName.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    strokeName.Parent = nameLabel

    local healthLabel = Instance.new("TextLabel")
    healthLabel.Size = UDim2.new(1, 0, 0.3, 0)
    healthLabel.Position = UDim2.new(0, 0, 0.35, 0)
    healthLabel.BackgroundTransparency = 1
    healthLabel.Text = "♥ 100%"
    healthLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    healthLabel.Font = Enum.Font.SourceSans
    healthLabel.TextSize = 16
    healthLabel.Parent = bg
    local strokeHealth = Instance.new("UIStroke")
    strokeHealth.Thickness = 1.5
    strokeHealth.Color = Color3.fromRGB(0, 0, 0)
    strokeHealth.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    strokeHealth.Parent = healthLabel

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.35, 0)
    distLabel.Position = UDim2.new(0, 0, 0.65, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0m"
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.Font = Enum.Font.SourceSans
    distLabel.TextSize = 14
    distLabel.Parent = bg
    local strokeDist = Instance.new("UIStroke")
    strokeDist.Thickness = 1.5
    strokeDist.Color = Color3.fromRGB(0, 0, 0)
    strokeDist.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    strokeDist.Parent = distLabel

    playerBillboards[player] = { Bill = bill, Name = nameLabel, Health = healthLabel, Dist = distLabel }

    playerConnections[player] = player.CharacterAdded:Connect(function()
        removePlayerBillboard(player)
        task.wait(0.5)
        if espToggle.Value then createPlayerBillboard(player) end
    end)
end

local function clearAllPlayerBillboards()
    for player, data in pairs(playerBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(playerBillboards)
    for _, conn in pairs(playerConnections) do conn:Disconnect() end
    table.clear(playerConnections)
end

local function updateAllPlayers()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(playerBillboards) do
        local char = player.Character
        local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if humanoid and root and localRoot then
            local hp = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
            data.Health.Text = "♥ " .. hp .. "%"
            data.Health.TextColor3 = hp > 50 and Color3.fromRGB(0, 255, 0) or (hp > 25 and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 0, 0))

            local dist = (root.Position - localRoot.Position).Magnitude
            data.Dist.Text = math.floor(dist) .. "m"

            if espUseTeamColor.Value and player.TeamColor then
                data.Name.TextColor3 = player.TeamColor.Color
            else
                data.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end

espToggle:OnChanged(function(v)
    if v then
        for _, player in pairs(Players:GetPlayers()) do createPlayerBillboard(player) end
        if playerRenderConn then playerRenderConn:Disconnect() end
        playerRenderConn = RunService.RenderStepped:Connect(updateAllPlayers)
        Notify{ Title = "👁️ ESP Player", Content = "Đã bật!", Duration = 2 }
    else
        if playerRenderConn then playerRenderConn:Disconnect(); playerRenderConn = nil end
        clearAllPlayerBillboards()
        Notify{ Title = "👁️ ESP Player", Content = "Đã tắt.", Duration = 2 }
    end
end)

espUseTeamColor:OnChanged(function() updateAllPlayers() end)
Players.PlayerAdded:Connect(function(player) if espToggle.Value then createPlayerBillboard(player) end end)
Players.PlayerRemoving:Connect(function(player) removePlayerBillboard(player) end)

-- =============================================
-- 2. ESP GOD
-- =============================================
local espGodToggle = ESPTab:CreateToggle("espGodToggle", { Title = "✨ ESP God (trong Resources)", Default = false })
local godBillboards = {}
local godRenderConn = nil
local godNames = { "Ancient God", "Furious God", "Hateful God", "Lonely God", "Miserable God", "Old God", "Sleeping God", "Wealthy God" }

local function clearAllGodBillboards()
    for _, data in pairs(godBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(godBillboards)
end

local function stepGodESP()
    local resources = Workspace:FindFirstChild("Resources")
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    if not resources or not localRoot then return end

    for _, model in ipairs(resources:GetChildren()) do
        if model:IsA("Model") and table.find(godNames, model.Name) and not godBillboards[model] then
            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if primary then
                local bill = Instance.new("BillboardGui")
                bill.Name = "GodESP"
                bill.Size = UDim2.new(0, 200, 0, 35)
                bill.Adornee = primary
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 3, 0)
                bill.Parent = primary

                -- Nền trong suốt
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundTransparency = 1
                bg.BorderSizePixel = 0
                bg.Parent = bill

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = model.Name .. " (...m)"
                label.TextColor3 = Color3.fromRGB(255, 100, 255)
                label.Font = Enum.Font.SourceSans
                label.TextSize = 18
                label.Parent = bg
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Parent = label

                godBillboards[model] = { Bill = bill, Label = label, Part = primary }
            end
        end
    end

    for model, data in pairs(godBillboards) do
        if not model.Parent then
            if data.Bill then data.Bill:Destroy() end
            godBillboards[model] = nil
        else
            local dist = (data.Part.Position - localRoot.Position).Magnitude
            data.Label.Text = model.Name .. " (" .. math.floor(dist) .. "m)"
        end
    end
end

espGodToggle:OnChanged(function(v)
    if v then
        if godRenderConn then godRenderConn:Disconnect() end
        godRenderConn = RunService.RenderStepped:Connect(stepGodESP)
        Notify{ Title = "✨ ESP God", Content = "Đã bật!", Duration = 2 }
    else
        if godRenderConn then godRenderConn:Disconnect(); godRenderConn = nil end
        clearAllGodBillboards()
        Notify{ Title = "✨ ESP God", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- 3. ESP ORE
-- =============================================
local oreDisplayToOriginal = {
    ["Rich Adurite"] = "Adurite Rich Rock",
    ["Adurite"] = "Adurite Rock",
    ["Coal"] = "Coal Node",
    ["Gold"] = "Gold Node",
    ["Iron"] = "Iron Node",
    ["Stone"] = "Stone Node",
    ["Emerald"] = "Emerald Lode",
    ["Crystal"] = "Crystal Lode"
}
local oreDisplayNames = {"Rich Adurite", "Adurite", "Coal", "Gold", "Iron", "Stone", "Emerald", "Crystal"}

local selectedOres = { "Rich Adurite", "Adurite" }

local oreDropdown = ESPTab:CreateDropdown("oreDropdown", {
    Title = "⛏️ Chọn loại Ore (Multi)",
    Values = oreDisplayNames,
    Default = { ["Rich Adurite"] = true, ["Adurite"] = true },
    Multi = true
})

oreDropdown:OnChanged(function(value)
    selectedOres = {}
    for name, state in pairs(value) do
        if state then table.insert(selectedOres, name) end
    end
end)

local espOreToggle = ESPTab:CreateToggle("espOreToggle", { Title = "👁️ ESP Ore", Default = false })
local oreBillboards = {}
local oreRenderConn = nil

local function clearAllOreBillboards()
    for _, data in pairs(oreBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(oreBillboards)
end

local function stepOreESP()
    if #selectedOres == 0 then clearAllOreBillboards(); return end

    local resources = Workspace:FindFirstChild("Resources")
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    if not resources or not localRoot then return end

    local targetOriginalNames = {}
    for _, displayName in ipairs(selectedOres) do
        local original = oreDisplayToOriginal[displayName]
        if original then targetOriginalNames[original] = true end
    end

    for _, model in ipairs(resources:GetChildren()) do
        if model:IsA("Model") and targetOriginalNames[model.Name] and not oreBillboards[model] then
            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if primary then
                local displayName = model.Name
                for d, o in pairs(oreDisplayToOriginal) do
                    if o == model.Name then displayName = d; break end
                end

                local bill = Instance.new("BillboardGui")
                bill.Name = "OreESP"
                bill.Size = UDim2.new(0, 200, 0, 35)
                bill.Adornee = primary
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 2, 0)
                bill.Parent = primary

                -- Nền trong suốt
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundTransparency = 1
                bg.BorderSizePixel = 0
                bg.Parent = bill

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = displayName .. " (...m)"
                label.TextColor3 = Color3.fromRGB(255, 215, 0)
                label.Font = Enum.Font.SourceSans
                label.TextSize = 18
                label.Parent = bg
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Parent = label

                oreBillboards[model] = { Bill = bill, Label = label, DisplayName = displayName, Part = primary }
            end
        end
    end

    for model, data in pairs(oreBillboards) do
        if not model.Parent or not targetOriginalNames[model.Name] then
            if data.Bill then data.Bill:Destroy() end
            oreBillboards[model] = nil
        else
            local dist = (data.Part.Position - localRoot.Position).Magnitude
            data.Label.Text = data.DisplayName .. " (" .. math.floor(dist) .. "m)"
        end
    end
end

espOreToggle:OnChanged(function(v)
    if v then
        if oreRenderConn then oreRenderConn:Disconnect() end
        oreRenderConn = RunService.RenderStepped:Connect(stepOreESP)
        Notify{ Title = "⛏️ ESP Ore", Content = "Đã bật!", Duration = 2 }
    else
        if oreRenderConn then oreRenderConn:Disconnect(); oreRenderConn = nil end
        clearAllOreBillboards()
        Notify{ Title = "⛏️ ESP Ore", Content = "Đã tắt.", Duration = 2 }
    end
end)

-- =============================================
-- TAB 3: MISC
-- =============================================
local MiscTab = Window:AddTab({ Title = "Misc", Icon = "settings" })

-- =============================================
-- SERVER HOP
-- =============================================
MiscTab:CreateButton({
    Title = "🚀 Server Hop (ít người nhất)",
    Callback = function()
        local placeId = game.PlaceId
        local universeId = game.GameId
        local url = "https://games.roblox.com/v1/games/" .. tostring(universeId) .. "/servers/Public?limit=100"
        local success, response = pcall(function() return game:HttpGet(url) end)
        if not success then
            Notify{ Title = "Lỗi", Content = "Không kết nối API.", Duration = 5 }
            return
        end
        local data
        pcall(function() data = HttpService:JSONDecode(response) end)
        if not data or not data.data then
            Notify{ Title = "Lỗi", Content = "Dữ liệu server không hợp lệ.", Duration = 5 }
            return
        end
        local best, min = nil, 999
        for _, server in pairs(data.data) do
            if server.id ~= game.JobId then
                local count = server.playing or 0
                if count < min then
                    min = count; best = server
                end
            end
        end
        if best then
            Notify{ Title = "Đang chuyển", Content = "Server có " .. min .. " người.", Duration = 3 }
            TeleportService:TeleportToPlaceInstance(placeId, best.id, LocalPlayer)
        else
            Notify{ Title = "Thông báo", Content = "Bạn đang ở server ít nhất!", Duration = 5 }
        end
    end
})

-- =============================================
