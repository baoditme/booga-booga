-- ===== REMOTE OPCODES (Dễ dàng thay đổi khi game update) =====
OPCODES = {
    PICKUP = 51,   -- Nhặt đồ / Thu hoạch quả
    EAT    = 59,   -- Ăn thức ăn
    PLACE  = 68,   -- Đặt công trình (Plant Box / Hut)
    PLANT  = 85,   -- Gieo hạt giống (Plant Box)
}


-- ===== NOTIFY WRAPPER =====
local function Notify(args)
    if notifyEnabled then
        Rayfield:Notify({
            Title = args.Title or "Notification",
            Content = args.Content or "",
            Duration = args.Duration or 3,
            Image = 4483362458
        })
    end
end

-- ===== TEAM CHECK (DÙNG CHUNG CHO PVP) =====
local function isSameTeam(player)
    if not player or not LocalPlayer then return false end
    local playerTeam = player.Team and player.Team.Name or (player.TeamColor and player.TeamColor.Name or "NoTribe")
    local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name or (LocalPlayer.TeamColor and LocalPlayer.TeamColor.Name or "NoTribe")
    
    if playerTeam == "NoTribe" or myTeam == "NoTribe" then return false end
    return playerTeam == myTeam
end

-- ===== DYNAMIC HITBOX =====
local hitboxFullSize = Vector3.new(15, 15, 15)
local hitboxDefaultSize = Vector3.new(2, 1, 1)

local function updateHitbox()
    if not hitboxActive or not LocalPlayer.Character then return end
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer and player.UserId ~= LocalPlayer.UserId then
            local pchar = player.Character
            local rootPart = pchar and pchar:FindFirstChild("HumanoidRootPart")
            if rootPart then
                if isSameTeam(player) then
                    rootPart.Size = hitboxDefaultSize
                    rootPart.Transparency = 0
                else
                    local dist = (rootPart.Position - localRoot.Position).Magnitude
                    local size = (dist >= 10 and hitboxFullSize) or (dist <= 5 and hitboxDefaultSize) or (hitboxDefaultSize + (hitboxFullSize - hitboxDefaultSize) * ((dist - 5) / 5))
                    rootPart.Size = size
                    rootPart.Transparency = 0.7
                    rootPart.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    end
end

