    MinSize = Vector2.new(400, 500),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
}

-- =============================================
-- AUTO RESIZE GUI (PC + MOBILE)
-- =============================================
local function autoResizeGUI()
    local viewportSize = Camera.ViewportSize
    local screenWidth = viewportSize.X
    local screenHeight = viewportSize.Y
    
    local isMobile = screenWidth < 800 or UserInputService.TouchEnabled
    
    local windowWidth = isMobile and math.min(screenWidth * 0.9, 500) or 550
    local windowHeight = isMobile and math.min(screenHeight * 0.85, 600) or 700
    local tabWidth = isMobile and math.min(screenWidth * 0.15, 120) or 160
    
    pcall(function()
        Window:SetSize(UDim2.fromOffset(windowWidth, windowHeight))
        Window:SetTabWidth(tabWidth)
    end)
    
    local fluentGui
    for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:find("Fluent") then
            fluentGui = gui
            break
        end
    end
    
    if fluentGui then
        local mainFrame = fluentGui:FindFirstChild("Main")
        if mainFrame and mainFrame:IsA("Frame") then
            if isMobile then
                mainFrame.Position = UDim2.new(0.05, 0, 0.05, 0)
                mainFrame.Size = UDim2.new(0.9, 0, 0.9, 0)
            end
        end
    end
end

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(autoResizeGUI)

