        if v then
            if traderRenderConn then traderRenderConn:Disconnect() end
            traderRenderConn = RunService.RenderStepped:Connect(stepTraderESP)
            Notify{ Title = "ESP Trader", Content = "Enabled", Duration = 2 }
        else
            if traderRenderConn then traderRenderConn:Disconnect(); traderRenderConn = nil end
            clearTraderESP()
