local espTraderEnabled = false
local traderBillboard = nil
local traderRenderConn = nil

local function clearTraderESP()
    if traderBillboard then
        if traderBillboard.Bill then traderBillboard.Bill:Destroy() end
        traderBillboard = nil
    end
end

local function stepTraderESP()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local dialogNPCs = Workspace:FindFirstChild("DialogNPCs")
    local normalNPCs = dialogNPCs and dialogNPCs:FindFirstChild("Normal")
    local trader = normalNPCs and normalNPCs:FindFirstChild("Wandering Trader")

    if trader and not traderBillboard then
        local primary = trader.PrimaryPart or trader:FindFirstChildWhichIsA("BasePart") or trader:FindFirstChild("Head")
        if primary then
            local bill = Instance.new("BillboardGui")
            bill.Name = "TraderESP"
            bill.Size = UDim2.new(0, 200, 0, 35)
            bill.Adornee = primary
            bill.AlwaysOnTop = true
            bill.StudsOffset = Vector3.new(0, 3, 0)
            bill.Parent = primary

            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.BackgroundTransparency = 1
            bg.BorderSizePixel = 0
            bg.Parent = bill

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "Wandering Trader [...m]"
            label.TextColor3 = Color3.fromRGB(0, 255, 220) -- Màu xanh ngọc sáng
            label.Font = Enum.Font.SourceSans
            label.TextSize = 18
            label.Parent = bg

            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1.5
            stroke.Color = Color3.fromRGB(0, 0, 0)
            stroke.Parent = label

            traderBillboard = { Bill = bill, Label = label, Part = primary, Model = trader }
        end
    end

    if traderBillboard then
        if not traderBillboard.Model or not traderBillboard.Model.Parent then
            clearTraderESP()
        else
            local dist = (traderBillboard.Part.Position - localRoot.Position).Magnitude
            traderBillboard.Label.Text = "Wandering Trader [" .. math.floor(dist) .. "m]"
        end
    end
end

