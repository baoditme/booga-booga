-- =============================================
-- PLACE PLANT BOX (20 BOXES GRID - FOLLOW PLAYER)
-- =============================================
AutoFarmTab:CreateSection("Place Plant Box")

local plantBoxPreviewParts = {}
local plantBoxScreenGui = nil
local plantBoxGridVisible = false
local plantBoxUpdateConn = nil
local PLANT_BOX_SPACING = 8 -- ĐÃ ĐỔI: Khoảng cách giữa các ô = 10
local PLANT_BOX_GRID_COLS = 5
local PLANT_BOX_GRID_ROWS = 4

-- Buffer Plant Box chuẩn 31 Bytes (Khớp 100% gói ByteNet game)
local function buildPlantBoxBuffer(x, y, z)
    local b = buffer.create(31)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, OPCODES.PLACE)
    buffer.writeu8(b, 2, 9)
    buffer.writeu8(b, 3, 0)

    local name = "Plant Box"
    for i = 1, #name do
        buffer.writeu8(b, 3 + i, string.byte(name, i))
    end

    buffer.writef32(b, 13, x)
    buffer.writef32(b, 17, y)
    buffer.writef32(b, 21, z)

    for i = 25, 30 do
        buffer.writeu8(b, i, 0)
    end

    return b
end

-- Raycast xuống mặt đất tại vị trí XZ
local function raycastGroundY(posX, posZ, ignoreChar)
    local rayOrigin = Vector3.new(posX, 500, posZ)
    local rayDirection = Vector3.new(0, -1000, 0)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignoreList = {}
    if ignoreChar then
        table.insert(ignoreList, ignoreChar)
    end
    for _, p in ipairs(plantBoxPreviewParts) do
        table.insert(ignoreList, p)
    end
    params.FilterDescendantsInstances = ignoreList

    local result = workspace:Raycast(rayOrigin, rayDirection, params)
    if result then
        return result.Position.Y
    end
    return 0
end

-- Cập nhật vị trí 20 ô theo người chơi mỗi frame
local function updatePlantBoxGridPositions()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or #plantBoxPreviewParts == 0 then return end

    local centerPos = hrp.Position
    local startX = centerPos.X - ((PLANT_BOX_GRID_COLS - 1) / 2) * PLANT_BOX_SPACING
    local startZ = centerPos.Z - ((PLANT_BOX_GRID_ROWS - 1) / 2) * PLANT_BOX_SPACING

    local index = 1
    for row = 0, PLANT_BOX_GRID_ROWS - 1 do
        for col = 0, PLANT_BOX_GRID_COLS - 1 do
            local part = plantBoxPreviewParts[index]
            if part and part.Parent then
                local posX = startX + col * PLANT_BOX_SPACING
                local posZ = startZ + row * PLANT_BOX_SPACING
                local posY = raycastGroundY(posX, posZ, char)
                part.Position = Vector3.new(posX, posY + 0.15, posZ)
            end
            index = index + 1
        end
    end
end

-- Xóa tất cả ô vuông preview
local function clearPlantBoxGrid()
    if plantBoxUpdateConn then
        plantBoxUpdateConn:Disconnect()
        plantBoxUpdateConn = nil
    end
    for _, part in ipairs(plantBoxPreviewParts) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    table.clear(plantBoxPreviewParts)
end

-- Tạo 20 ô vuông trắng xung quanh người chơi
local function createPlantBoxGrid()
    clearPlantBoxGrid()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local centerPos = hrp.Position
    local startX = centerPos.X - ((PLANT_BOX_GRID_COLS - 1) / 2) * PLANT_BOX_SPACING
    local startZ = centerPos.Z - ((PLANT_BOX_GRID_ROWS - 1) / 2) * PLANT_BOX_SPACING

    for row = 0, PLANT_BOX_GRID_ROWS - 1 do
        for col = 0, PLANT_BOX_GRID_COLS - 1 do
            local posX = startX + col * PLANT_BOX_SPACING
            local posZ = startZ + row * PLANT_BOX_SPACING
            local posY = raycastGroundY(posX, posZ, char)

            local part = Instance.new("Part")
            part.Name = "PlantBoxPreview_" .. (#plantBoxPreviewParts + 1)
            part.Size = Vector3.new(3, 0.3, 3)
            part.Position = Vector3.new(posX, posY + 0.15, posZ)
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.Material = Enum.Material.SmoothPlastic
            part.Color = Color3.fromRGB(255, 255, 255)
            part.Transparency = 0.3
            part.Parent = workspace

            local selBox = Instance.new("SelectionBox")
            selBox.Adornee = part
            selBox.Color3 = Color3.fromRGB(0, 0, 0)
            selBox.LineThickness = 0.02
            selBox.Transparency = 0.5
            selBox.Parent = part

            table.insert(plantBoxPreviewParts, part)
        end
    end

    if plantBoxUpdateConn then
        plantBoxUpdateConn:Disconnect()
    end
    plantBoxUpdateConn = RunService.RenderStepped:Connect(updatePlantBoxGridPositions)
end

-- Ẩn Rayfield GUI
local function hideRayfieldGui()
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
    for _, gui in ipairs(guiParent:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():find("rayfield") or gui:FindFirstChild("Main")) then
            gui.Enabled = false
        end
    end
end

-- Hiện Rayfield GUI
local function showRayfieldGui()
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
    for _, gui in ipairs(guiParent:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():find("rayfield") or gui:FindFirstChild("Main")) then
            gui.Enabled = true
        end
    end
end

-- Xóa UI Place/Cancel
local function removePlantBoxUI()
    if plantBoxScreenGui then
        plantBoxScreenGui:Destroy()
        plantBoxScreenGui = nil
    end
end

-- Tạo nút Place và Cancel trên màn hình
local function createPlantBoxUI()
    removePlantBoxUI()

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "PlantBoxControlGui"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999998
    screenGui.Parent = LocalPlayer.PlayerGui
    plantBoxScreenGui = screenGui

    local container = Instance.new("Frame")
    container.Name = "ButtonContainer"
    container.Size = UDim2.new(0, 320, 0, 60)
    container.Position = UDim2.new(0.5, -160, 1, -100)
    container.BackgroundTransparency = 1
    container.Parent = screenGui

    -- Nút PLACE
    local placeBtn = Instance.new("TextButton")
    placeBtn.Name = "PlaceButton"
    placeBtn.Size = UDim2.new(0, 145, 0, 50)
    placeBtn.Position = UDim2.new(0, 0, 0, 0)
    placeBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 50)
    placeBtn.Text = "PLACE"
    placeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    placeBtn.Font = Enum.Font.GothamBold
    placeBtn.TextSize = 20
    placeBtn.Parent = container

    local placeCorner = Instance.new("UICorner")
    placeCorner.CornerRadius = UDim.new(0, 10)
    placeCorner.Parent = placeBtn

    local placeStroke = Instance.new("UIStroke")
    placeStroke.Thickness = 2
    placeStroke.Color = Color3.fromRGB(255, 255, 255)
    placeStroke.Transparency = 0.5
    placeStroke.Parent = placeBtn

    -- Nút CANCEL
    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Name = "CancelButton"
    cancelBtn.Size = UDim2.new(0, 145, 0, 50)
    cancelBtn.Position = UDim2.new(0, 175, 0, 0)
    cancelBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
    cancelBtn.Text = "CANCEL"
    cancelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    cancelBtn.Font = Enum.Font.GothamBold
    cancelBtn.TextSize = 20
    cancelBtn.Parent = container

    local cancelCorner = Instance.new("UICorner")
    cancelCorner.CornerRadius = UDim.new(0, 10)
    cancelCorner.Parent = cancelBtn

    local cancelStroke = Instance.new("UIStroke")
    cancelStroke.Thickness = 2
    cancelStroke.Color = Color3.fromRGB(255, 255, 255)
    cancelStroke.Transparency = 0.5
    cancelStroke.Parent = cancelBtn

    -- Label hiển thị trạng thái
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(0, 320, 0, 25)
    statusLabel.Position = UDim2.new(0, 0, 0, -30)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "20 Plant Boxes ready to place"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 16
    statusLabel.Parent = container

    local statusStroke = Instance.new("UIStroke")
    statusStroke.Thickness = 1.5
    statusStroke.Color = Color3.fromRGB(0, 0, 0)
    statusStroke.Parent = statusLabel

    -- SỰ KIỆN BẤM NÚT PLACE
    placeBtn.Activated:Connect(function()
        if #plantBoxPreviewParts == 0 then return end

        if plantBoxUpdateConn then
            plantBoxUpdateConn:Disconnect()
            plantBoxUpdateConn = nil
        end

        placeBtn.Active = false
        placeBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        placeBtn.Text = "PLACING..."
        cancelBtn.Active = false
        cancelBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

        local remote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
        if not remote then
            if typeof(Notify) == "function" then
                Notify{ Title = "Plant Box", Content = "ByteNetReliable not found!", Duration = 2 }
            end
            clearPlantBoxGrid()
            removePlantBoxUI()
            showRayfieldGui()
            plantBoxGridVisible = false
            return
        end

        local totalBoxes = #plantBoxPreviewParts
        local placedCount = 0

        for _, previewPart in ipairs(plantBoxPreviewParts) do
            if not previewPart or not previewPart.Parent then continue end

            local pos = previewPart.Position
            local bufData = buildPlantBoxBuffer(pos.X, pos.Y, pos.Z)

            pcall(function()
                remote:FireServer(bufData, nil)
            end)

            placedCount = placedCount + 1

            previewPart.Color = Color3.fromRGB(0, 200, 50)
            previewPart.Transparency = 0.6

            statusLabel.Text = "Placing... " .. placedCount .. "/" .. totalBoxes

            task.wait(0.5) -- ĐÃ ĐỔI: Cooldown 0.5s giữa mỗi lần đặt
        end

        statusLabel.Text = "Done! Placed " .. placedCount .. " boxes"
        if typeof(Notify) == "function" then
            Notify{ Title = "Plant Box", Content = "Placed " .. placedCount .. " Plant Boxes!", Duration = 3 }
        end

        task.wait(0.8)
        clearPlantBoxGrid()
        removePlantBoxUI()
        showRayfieldGui()
        plantBoxGridVisible = false
    end)

    -- Sự kiện nút CANCEL
    cancelBtn.Activated:Connect(function()
        clearPlantBoxGrid()
        removePlantBoxUI()
        showRayfieldGui()
        plantBoxGridVisible = false
        if typeof(Notify) == "function" then
            Notify{ Title = "Plant Box", Content = "Cancelled", Duration = 2 }
        end
    end)
end

-- Nút bấm trong Auto Farm Tab
AutoFarmTab:CreateButton({
    Name = "Place 20 Plant Boxes (Grid)",
    Callback = function()
        if plantBoxGridVisible then
            if typeof(Notify) == "function" then
                Notify{ Title = "Plant Box", Content = "Grid already visible!", Duration = 2 }
            end
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            if typeof(Notify) == "function" then
                Notify{ Title = "Plant Box", Content = "Character not found!", Duration = 2 }
            end
            return
        end

        plantBoxGridVisible = true

        createPlantBoxGrid()
        hideRayfieldGui()
        createPlantBoxUI()

        if typeof(Notify) == "function" then
            Notify{ Title = "Plant Box", Content = "Grid follows you! Press PLACE or CANCEL", Duration = 3 }
        end
    end
})

