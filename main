local warningLoop
local lastWarningTime = 0
local warningSound = nil

local function createWarningSound()
    if not warningSound then
        warningSound = Instance.new("Sound")
        warningSound.Name = "WarningSound"
        warningSound.SoundId = "rbxassetid://9126397040"
        warningSound.Volume = 0.5
        warningSound.Parent = Workspace
    end
end

CombatTab:CreateToggle({
    Name = "Proximity Warning (100 studs)",
    CurrentValue = false,
    Flag = "warningToggle",
    Callback = function(v)
        warningEnabled = v
        if warningLoop then warningLoop:Disconnect() end
        if v then
            createWarningSound()
            warningLoop = RunService.Heartbeat:Connect(function()
                if not warningEnabled then return end
                if not LocalPlayer.Character then return end
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local warnPlayers = {}
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        if isSameTeam(player) then continue end
                        local pchar = player.Character
                        if pchar then
                            local root = pchar:FindFirstChild("HumanoidRootPart")
                            if root then
                                local dist = (root.Position - hrp.Position).Magnitude
                                if dist <= 100 then
                                    table.insert(warnPlayers, {Name = player.Name, Dist = math.floor(dist)})
                                end
                            end
                        end
                    end
                end
                if #warnPlayers > 0 and os.time() - lastWarningTime >= 5 then
                    local names = ""
                    for i, p in ipairs(warnPlayers) do
                        names = names .. p.Name .. " (" .. p.Dist .. "m) "
                        if i >= 3 then
                            names = names .. "and " .. (#warnPlayers - i) .. " more"
                            break
                        end
                    end
                    Notify{
                        Title = "Enemy Nearby",
                        Content = #warnPlayers .. " players within 100 studs\n" .. names,
                        Duration = 5
                    }
                    lastWarningTime = os.time()
                    if warningSound then
                        warningSound:Stop()
                        warningSound:Play()
                    end
                end
            end)
            Notify{ Title = "Proximity Warning", Content = "Enabled", Duration = 2 }
        else
            if warningSound then warningSound:Stop() end
            Notify{ Title = "Proximity Warning", Content = "Disabled", Duration = 2 }
        end
    end
})

local hitboxLoop = nil
local hitboxFullSize = Vector3.new(15, 15, 15)
local hitboxDefaultSize = Vector3.new(2, 1, 1)

local function updateHitbox()
    if not hitboxActive then return end
    if not LocalPlayer.Character then return end
    local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if isSameTeam(player) then continue end
            local pchar = player.Character
            if pchar then
                local rootPart = pchar:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local dist = (rootPart.Position - localRoot.Position).Magnitude
                    local size
                    if dist >= 10 then
                        size = hitboxFullSize
                    elseif dist <= 5 then
                        size = hitboxDefaultSize
                    else
                        local t = (dist - 5) / (10 - 5)
                        size = hitboxDefaultSize + (hitboxFullSize - hitboxDefaultSize) * t
                    end
                    rootPart.Size = size
                    rootPart.Transparency = 0.7
                    rootPart.Color = Color3.fromRGB(255, 0, 0)
                end
            end
        end
    end
end

CombatTab:CreateToggle({
    Name = "Dynamic Hitbox",
    CurrentValue = false,
    Flag = "hitboxToggle",
    Callback = function(v)
        hitboxActive = v
        if hitboxLoop then hitboxLoop:Disconnect() end
        if v then
            hitboxLoop = RunService.RenderStepped:Connect(updateHitbox)
            Notify{ Title = "Dynamic Hitbox", Content = "Enabled", Duration = 2 }
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local pchar = player.Character
                    if pchar then
                        local rootPart = pchar:FindFirstChild("HumanoidRootPart")
                        if rootPart then
                            rootPart.Size = hitboxDefaultSize
                            rootPart.Transparency = 0
                            rootPart.Color = Color3.fromRGB(255, 255, 255)
                        end
                    end
                end
            end
            Notify{ Title = "Dynamic Hitbox", Content = "Disabled", Duration = 2 }
        end
    end
})

local healRunning = false
local healTask = nil
local byteNetRemote = nil

local function getByteNetRemote()
    if not byteNetRemote then
        byteNetRemote = ReplicatedStorage:FindFirstChild("ByteNetReliable")
    end
    return byteNetRemote
end

local function getBloodfruitLayoutOrder()
    local success, result = pcall(function()
        local mainGui = LocalPlayer.PlayerGui:FindFirstChild("MainGui")
        if not mainGui then return nil end
        local rightPanel = mainGui:FindFirstChild("RightPanel")
        if not rightPanel then return nil end
        local inventory = rightPanel:FindFirstChild("Inventory")
        if not inventory then return nil end
        local list = inventory:FindFirstChild("List")
        if not list then return nil end

        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("ImageLabel") and child.Name == "Bloodfruit" then
                return child.LayoutOrder
            end
        end
        return nil
    end)

    if success then return result end
    return nil
end

local function createHealBufferDynamic()
    local layoutOrder = getBloodfruitLayoutOrder()
    if not layoutOrder then return nil end
    local bytes = { 0, 67, layoutOrder, 0 }
    local b = buffer.create(#bytes)
    for i = 1, #bytes do
        buffer.writeu8(b, i - 1, bytes[i])
    end
    return b
end

local function sendHeal()
    local event = getByteNetRemote()
    if not event then return false end
    local bufferData = createHealBufferDynamic()
    if not bufferData then return false end
    pcall(function() event:FireServer(bufferData, nil) end)
    return true
end

local function healLoopFunction()
    while healRunning do
        if not autoHealEnabled then break end

        local currentHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not currentHum then
            task.wait(0.1)
            continue
        end

        if currentHum.Health < 100 then
            local startTime = tick()
            while healRunning and autoHealEnabled and LocalPlayer.Character do
                currentHum = LocalPlayer.Character:FindFirstChild("Humanoid")
                if not currentHum then break end
                if currentHum.Health >= 100 then break end
                sendHeal()
                task.wait(0.0001)
                if tick() - startTime > 2 then break end
            end
        end

        task.wait(0.1)
    end
end

local autoHealToggleObj
autoHealToggleObj = CombatTab:CreateToggle({
    Name = "Auto Heal (Bloodfruit)",
    CurrentValue = false,
    Flag = "autoHealToggle",
    Callback = function(v)
        autoHealEnabled = v
        if healTask then task.cancel(healTask); healTask = nil end

        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Heal", Content = "Disabled", Duration = 2 }
                autoHealToggleObj:Set(false)
                return
            end
            local layoutOrder = getBloodfruitLayoutOrder()
            if not layoutOrder then
                Notify{ Title = "Auto Heal", Content = "Disabled", Duration = 2 }
                autoHealToggleObj:Set(false)
                return
            end
            healRunning = true
            healTask = task.spawn(healLoopFunction)
            Notify{ Title = "Auto Heal", Content = "Enabled", Duration = 2 }
        else
            healRunning = false
            Notify{ Title = "Auto Heal", Content = "Disabled", Duration = 2 }
        end
    end
})

local healV2Running = false
local healV2Task = nil

local function healV2LoopFunction()
    while healV2Running do
        if not autoHealV2Enabled then break end

        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")

        if not hrp then
            task.wait(0.1)
            continue
        end

        local hasEnemy = false
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not isSameTeam(player) then
                local pChar = player.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local dist = (pRoot.Position - hrp.Position).Magnitude
                    if dist <= 7 then
                        hasEnemy = true
                        break
                    end
                end
            end
        end

        if hasEnemy then
            local startTime = tick()
            while healV2Running and autoHealV2Enabled and LocalPlayer.Character do
                sendHeal()
                task.wait()
                if tick() - startTime > 2 then break end
            end
        end

        task.wait(0.1)
    end
end

local autoHealV2ToggleObj
autoHealV2ToggleObj = CombatTab:CreateToggle({
    Name = "Auto Heal V2 (Enemy nearby)",
    CurrentValue = false,
    Flag = "autoHealV2Toggle",
    Callback = function(v)
        autoHealV2Enabled = v
        if healV2Task then task.cancel(healV2Task); healV2Task = nil end

        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Heal V2", Content = "Disabled", Duration = 2 }
                autoHealV2ToggleObj:Set(false)
                return
            end
            local layoutOrder = getBloodfruitLayoutOrder()
            if layoutOrder == nil then
                Notify{ Title = "Auto Heal V2", Content = "Disabled", Duration = 2 }
                autoHealV2ToggleObj:Set(false)
                return
            end
            healV2Running = true
            healV2Task = task.spawn(healV2LoopFunction)
            Notify{ Title = "Auto Heal V2", Content = "Enabled", Duration = 2 }
        else
            healV2Running = false
            Notify{ Title = "Auto Heal V2", Content = "Disabled", Duration = 2 }
        end
    end
})

