    ["Rich Adurite"] = "Adurite Rich Rock",
    ["Adurite"] = "Adurite Rock",
    ["Coal"] = "Coal Node",
    ["Gold"] = "Gold Node",
    ["Iron"] = "Iron Node",
    ["Stone"] = "Stone Node",
    ["Emerald"] = "Emerald Lode",
    ["Crystal"] = "Crystal Lode"
}
