-- =============================================
-- AUTO PLACE BIG OL' HUT (PVP - COOLDOWN 10S CHỐNG SPAM)
-- =============================================
CombatTab:CreateSection("Auto Defense")

local autoHutEnabled = false
local autoHutDistance = 3
local autoHutTask = nil

-- Cấu hình Cooldown
local hasPlacedHut = false
local lastLeftRangeTime = nil
local HUT_COOLDOWN = 10 -- Cooldown 10 giây

-- Buffer "Big Ol' Hut"
local function buildBigOlHutBuffer(x, y, z)
    local b = buffer.create(33)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, OPCODES.PLACE)
    buffer.writeu8(b, 2, 11)
    buffer.writeu8(b, 3, 0)

    local name = "Big Ol' Hut"
    for i = 1, #name do
        buffer.writeu8(b, 3 + i, string.byte(name, i))
    end

    buffer.writef32(b, 15, x)
    buffer.writef32(b, 19, y)
    buffer.writef32(b, 23, z)

    for i = 0, 5 do
        buffer.writeu8(b, 27 + i, 0)
    end

    return b
end

-- Lấy vị trí đặt: X/Z tại vị trí nhân vật của mình, Y = mặt đất (raycast)
local function getHutPlacementPos(myHrp)
    local posX = myHrp.Position.X
    local posZ = myHrp.Position.Z

    local rayOrigin = Vector3.new(posX, myHrp.Position.Y + 10, posZ)
    local rayDirection = Vector3.new(0, -100, 0)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignoreList = {}
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    params.FilterDescendantsInstances = ignoreList

    local result = workspace:Raycast(rayOrigin, rayDirection, params)
    local finalY = result and result.Position.Y or myHrp.Position.Y

    return Vector3.new(posX, finalY, posZ)
end

-- Hàm kiểm tra xem Hut đã xuất hiện trong Deployables chưa
local function verifyHutPlacement(targetPos, timeout)
    task.spawn(function()
        local deployables = workspace:FindFirstChild("Deployables")
        local isSuccess = false
        local startTime = tick()
        local maxWait = timeout or 1.0
        local checkRadius = 6 -- Khoảng cách tối đa so với tọa độ đặt

        while (tick() - startTime) < maxWait do
            if deployables then
                for _, item in pairs(deployables:GetChildren()) do
                    if item.Name == "Big Ol' Hut" then
                        local pivotPos = item:GetPivot().Position
                        -- So sánh khoảng cách X và Z
                        local dist = (Vector2.new(pivotPos.X, pivotPos.Z) - Vector2.new(targetPos.X, targetPos.Z)).Magnitude
                        if dist <= checkRadius then
                            isSuccess = true
                            break
                        end
                    end
                end
            end

            if isSuccess then break end
            task.wait(0.1)
        end

        if isSuccess then
            Notify{
                Title = "Auto Hut",
                Content = "Placed done!",
                Duration = 2
            }
        else
            -- Đặt thất bại -> Cho phép đặt lại
            hasPlacedHut = false
            Notify{
                Title = "Auto Hut",
                Content = "place failed!",
                Duration = 2
            }
        end
    end)
end

local function autoHutLoop()
    while autoHutEnabled do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if hrp then
            local enemyNearby = false

            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.UserId ~= LocalPlayer.UserId and not isSameTeam(player) then
                    local eChar = player.Character
                    local eHrp = eChar and eChar:FindFirstChild("HumanoidRootPart")
                    local eHum = eChar and eChar:FindFirstChild("Humanoid")

                    if eHrp and eHum and eHum.Health > 0 then
                        local dist = (eHrp.Position - hrp.Position).Magnitude

                        if dist <= autoHutDistance then
                            enemyNearby = true

                            -- NẾU CHƯA ĐẶT HUT VÀ HẾT COOLDOWN -> ĐẶT HUT
                            if not hasPlacedHut then
                                local placePos = getHutPlacementPos(hrp)
                                local remote = getByteNetRemote()
                                if remote then
                                    hasPlacedHut = true
                                    lastLeftRangeTime = nil -- Xóa đếm ngược

                                    remote:FireServer(
                                        buildBigOlHutBuffer(placePos.X, placePos.Y, placePos.Z),
                                        nil
                                    )

                                    -- Kiểm tra thực tế trong folder Deployables
                                    verifyHutPlacement(placePos, 1.2)
                                end
                            else
                                -- NẾU ĐÃ ĐẶT HUT MÀ KẺ THÙ VÀO LẠI RANGE KHI ĐANG COOLDOWN
                                -- -> RESET THỜI GIAN ĐẾM NGƯỢC VỀ 10S
                                lastLeftRangeTime = nil
                            end
                            break
                        end
                    end
                end
            end

            -- XỬ LÝ ĐẾM NGƯỢC 10S KHI RỜI/RA KHỎI RANGE
            if not enemyNearby and hasPlacedHut then
                if not lastLeftRangeTime then
                    -- Bắt đầu tính mốc thời gian vừa rời range
                    lastLeftRangeTime = tick()
                elseif tick() - lastLeftRangeTime >= HUT_COOLDOWN then
                    -- Đã rời xa đủ 10 giây liên tục -> Hết Cooldown!
                    hasPlacedHut = false
                    lastLeftRangeTime = nil
                end
            end
        end

        task.wait(0.1)
    end
end

local autoHutToggleObj = CombatTab:CreateToggle({
    Name = "Auto Place Big Ol' Hut (PVP)",
    CurrentValue = false,
    Flag = "autoHutToggle",
    Callback = function(v)
        autoHutEnabled = v
        hasPlacedHut = false
        lastLeftRangeTime = nil
        if autoHutTask then
            task.cancel(autoHutTask)
            autoHutTask = nil
        end
        if v then
            autoHutTask = task.spawn(autoHutLoop)
            Notify{ Title = "Auto Hut", Content = "Enabled", Duration = 2 }
        else
            Notify{ Title = "Auto Hut", Content = "Disabled", Duration = 2 }
        end
    end
})

CombatTab:CreateSlider({
    Name = "Hut Activation Distance",
    Range = {1, 8},
    Increment = 0.5,
    CurrentValue = 3,
    Suffix = " studs",
    Flag = "autoHutDistanceSlider",
    Callback = function(v)
        autoHutDistance = v
    end
})

