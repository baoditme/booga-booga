-- ======= SECTION 2: FRUIT FARM =======
AutoFarmTab:CreateSection("Fruit Farm")

local fruits = {
    Bloodfruit = 94, Bluefruit = 377, Lemon = 99, Coconut = 1,
    Jelly = 604, Banana = 606, Orange = 602, Oddberry = 32,
    Berry = 35, Strangefruit = 302, Strawberry = 282,
    Sunfruit = 128, Pumpkin = 80, ["Prickly Pear"] = 378,
    Apple = 243, Barley = 247, Cloudberry = 101, Carrot = 147
}
local fruitNames = {"Bloodfruit", "Bluefruit", "Lemon", "Coconut", "Jelly", "Banana", "Orange", "Oddberry", "Berry", "Strangefruit", "Strawberry", "Sunfruit", "Pumpkin", "Prickly Pear", "Apple", "Barley", "Cloudberry", "Carrot"}

local pickFruitEnabled = false
local plantFruitEnabled = false
local pickFruitRange = 15
local plantFruitRange = 15
local selectedFruit = "Bloodfruit"
local pickFruitTask = nil
local plantFruitTask = nil

local fruitTweenEnabled = false
local fruitTweenTask = nil
local fruitTweenObj = nil
local fruitHomePosition = nil
local fruitScanRadius = 200
local fruitStandDistance = 3

local function createPickFruitBuffer(entityID)
    local b = buffer.create(6)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, OPCODES.PICKUP)
    buffer.writeu32(b, 2, entityID)
    return b
end

local function createPlantFruitBuffer(entityID, fruitID)
    local b = buffer.create(8)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, OPCODES.PLANT)
    buffer.writeu32(b, 2, entityID)
    buffer.writeu16(b, 6, fruitID)
    return b
end

local function sendPickFruit(entityID)
    local event = getByteNetRemote()
    if not event then return false end
    pcall(function() event:FireServer(createPickFruitBuffer(entityID), nil) end)
    return true
end

local function sendPlantFruit(entityID, fruitID)
    local event = getByteNetRemote()
    if not event then return false end
    pcall(function() event:FireServer(createPlantFruitBuffer(entityID, fruitID), nil) end)
    return true
end

local function pickFruitLoop()
    while pickFruitEnabled do
        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local cropsFolder = Workspace:FindFirstChild("Crops")
        if hrp and cropsFolder then
            for _, item in ipairs(cropsFolder:GetChildren()) do
                if not pickFruitEnabled then break end
                local entityID = item:GetAttribute("EntityID")
                if entityID then
                    local primary = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
                    if primary and (primary.Position - hrp.Position).Magnitude <= pickFruitRange then
                        sendPickFruit(entityID)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function plantFruitLoop()
    while plantFruitEnabled do
        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local deployables = Workspace:FindFirstChild("Deployables")
        if hrp and deployables then
            local fruitID = fruits[selectedFruit] or 94
            for _, model in ipairs(deployables:GetChildren()) do
                if not plantFruitEnabled then break end
                if model:IsA("Model") and model.Name == "Plant Box" then
                    if not model:FindFirstChild("Seed") then
                        local entityID = model:GetAttribute("EntityID")
                        if entityID and entityID > 0 then
                            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                            if primary and (primary.Position - hrp.Position).Magnitude <= plantFruitRange then
                                sendPlantFruit(entityID, fruitID)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.15)
    end
end

local function fruitTweenTo(targetCFrame)
    return smartTween(targetCFrame, 16, function() return fruitTweenEnabled end)
end

local function fruitTweenToPart(modelPart, standDist, targetType)
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local modelPos = modelPart.Position

    if targetType == "box" then
        modelPos = modelPos + Vector3.new(0, 5, 0)
    end

    local currentPos = rootPart.Position
    local dir = (currentPos - modelPos).Magnitude > 0 and (currentPos - modelPos).Unit or Vector3.new(0, 0, 1)
    local targetPos = modelPos + dir * standDist
    local targetCFrame = CFrame.new(targetPos, modelPos)

    return fruitTweenTo(targetCFrame)
end

local function findEmptyBoxes(hrpPos)
    local results = {}
    local deployables = Workspace:FindFirstChild("Deployables")
    if not deployables then return results end

    for _, model in ipairs(deployables:GetChildren()) do
        if model:IsA("Model") and model.Name == "Plant Box" then
            if not model:FindFirstChild("Seed") then
                local entityID = model:GetAttribute("EntityID")
                if entityID and entityID > 0 then
                    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = (primary.Position - hrpPos).Magnitude
                        if dist <= fruitScanRadius then
                            table.insert(results, {
                                Type = "box",
                                Ref = model,
                                Part = primary,
                                Distance = dist
                            })
                        end
                    end
                end
            end
        end
    end

    return results
end

local function findCrops(hrpPos)
    local results = {}
    local cropsFolder = Workspace:FindFirstChild("Crops")
    if not cropsFolder then return results end

    for _, item in ipairs(cropsFolder:GetChildren()) do
        local entityID = item:GetAttribute("EntityID")
        if entityID then
            local primary
            if item:IsA("BasePart") then
                primary = item
            elseif item:IsA("Model") then
                primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
            end
            if primary then
                local dist = (primary.Position - hrpPos).Magnitude
                if dist <= fruitScanRadius then
                    table.insert(results, {
                        Type = "crop",
                        Ref = item,
                        Part = primary,
                        Distance = dist
                    })
                end
            end
        end
    end

    return results
end

local function buildTargetQueue()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end

    local playerPos = hrp.Position
    local queue = {}

    local boxes = findEmptyBoxes(playerPos)
    for _, box in ipairs(boxes) do
        table.insert(queue, box)
    end

    local crops = findCrops(playerPos)
    for _, crop in ipairs(crops) do
        table.insert(queue, crop)
    end

    table.sort(queue, function(a, b)
        return a.Distance < b.Distance
    end)

    return queue
end

local function isTargetValid(target)
    if not target.Ref or not target.Ref.Parent then return false end
    if not target.Part or not target.Part.Parent then return false end

    if target.Type == "box" then
        if target.Ref:FindFirstChild("Seed") then return false end
    end

    return true
end

local function fruitTweenLoop()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    fruitHomePosition = hrp.CFrame

    while fruitTweenEnabled do
        if not LocalPlayer.Character then task.wait(0.5); continue end
        hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.5); continue end

        local queue = buildTargetQueue()

        if #queue == 0 then
            task.wait(1)
            continue
        end

        for _, target in ipairs(queue) do
            if not fruitTweenEnabled then break end

            if isTargetValid(target) then
                fruitTweenToPart(target.Part, fruitStandDistance, target.Type)

                if not fruitTweenEnabled then break end

                local waitStart = tick()
                while fruitTweenEnabled and tick() - waitStart < 0.5 do
                    if not isTargetValid(target) then break end
                    task.wait(0.05)
                end
            end

            if not fruitTweenEnabled then break end
        end

        if not fruitTweenEnabled then break end

        local newQueue = buildTargetQueue()
        if #newQueue == 0 then
            if fruitHomePosition and fruitTweenEnabled then
                fruitTweenTo(fruitHomePosition)
            end
            task.wait(2)
        else
            task.wait(0.3)
        end
    end

    if fruitHomePosition and LocalPlayer.Character then
        local hrpCheck = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrpCheck then
            fruitTweenTo(fruitHomePosition)
        end
    end

    fruitHomePosition = nil
end

local pickFruitToggleObj
pickFruitToggleObj = AutoFarmTab:CreateToggle({
    Name = "Auto Pick Fruit",
    CurrentValue = false,
    Flag = "pickFruitToggle",
    Callback = function(v)
        pickFruitEnabled = v
        if pickFruitTask then task.cancel(pickFruitTask); pickFruitTask = nil end
        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Pick Fruit", Content = "Disabled", Duration = 2 }
                pickFruitToggleObj:Set(false)
                return
            end
            pickFruitTask = task.spawn(pickFruitLoop)
            Notify{ Title = "Auto Pick Fruit", Content = "Enabled", Duration = 2 }
        else
            Notify{ Title = "Auto Pick Fruit", Content = "Disabled", Duration = 2 }
        end
    end
})

