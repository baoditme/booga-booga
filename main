local zoomToggle = MiscTab:CreateToggle("zoomToggle", { Title = "🔭 Zoom vô cực (MaxZoomDistance)", Default = false })
local zoomCon

zoomToggle:OnChanged(function(v)
    if zoomCon then zoomCon:Disconnect() end
    if v then
        zoomCon = RunService.RenderStepped:Connect(function()
            pcall(function()
                workspace.CurrentCamera.MaxZoomDistance = 999999999
                workspace.CurrentCamera.MinZoomDistance = 0.5
            end)
        end)
        Notify{ Title = "🔭 Zoom", Content = "Đã bật zoom vô cực!", Duration = 2 }
    else
        pcall(function()
            workspace.CurrentCamera.MaxZoomDistance = 400
            workspace.CurrentCamera.MinZoomDistance = 1
        end)
        Notify{ Title = "🔭 Zoom", Content = "Đã tắt.", Duration = 2 }
    end
end)

