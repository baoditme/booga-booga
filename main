local playerBillboards = {}
local playerConnections = {}
local playerRenderConn = nil

local function removePlayerBillboard(player)
    local data = playerBillboards[player]
    if data and data.Bill then data.Bill:Destroy() end
    playerBillboards[player] = nil
    if playerConnections[player] then
        playerConnections[player]:Disconnect()
        playerConnections[player] = nil
    end
end

local function createPlayerBillboard(player)
    if player == LocalPlayer or playerBillboards[player] then return end
    local pchar = player.Character
    if not pchar then return end
    local head = pchar:FindFirstChild("Head")
    if not head then return end

    local bill = Instance.new("BillboardGui")
    bill.Name = "PlayerESP"
    bill.Size = UDim2.new(0, 250, 0, 80)
    bill.Adornee = head
    bill.AlwaysOnTop = true
    bill.StudsOffset = Vector3.new(0, 2.5, 0)
    bill.Parent = head

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.Parent = bill

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.35, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Font = Enum.Font.SourceSans
    nameLabel.TextSize = 18
    nameLabel.Parent = bg
    local sn = Instance.new("UIStroke")
    sn.Thickness = 1.5
    sn.Color = Color3.fromRGB(0, 0, 0)
    sn.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sn.Parent = nameLabel

    local healthLabel = Instance.new("TextLabel")
    healthLabel.Size = UDim2.new(1, 0, 0.3, 0)
    healthLabel.Position = UDim2.new(0, 0, 0.35, 0)
    healthLabel.BackgroundTransparency = 1
    healthLabel.Text = "HP 100%"
    healthLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    healthLabel.Font = Enum.Font.SourceSans
    healthLabel.TextSize = 16
    healthLabel.Parent = bg
    local sh = Instance.new("UIStroke")
    sh.Thickness = 1.5
    sh.Color = Color3.fromRGB(0, 0, 0)
    sh.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sh.Parent = healthLabel

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.35, 0)
    distLabel.Position = UDim2.new(0, 0, 0.65, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0m"
    distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLabel.Font = Enum.Font.SourceSans
    distLabel.TextSize = 14
    distLabel.Parent = bg
    local sd = Instance.new("UIStroke")
    sd.Thickness = 1.5
    sd.Color = Color3.fromRGB(0, 0, 0)
    sd.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    sd.Parent = distLabel

    playerBillboards[player] = { Bill = bill, Name = nameLabel, Health = healthLabel, Dist = distLabel }

    playerConnections[player] = player.CharacterAdded:Connect(function()
        removePlayerBillboard(player)
        task.wait(0.5)
        if espEnabled then createPlayerBillboard(player) end
    end)
end

local function clearAllPlayerBillboards()
    for _, data in pairs(playerBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(playerBillboards)
    for _, conn in pairs(playerConnections) do conn:Disconnect() end
    table.clear(playerConnections)
end

local function updateAllPlayers()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(playerBillboards) do
        local pchar = player.Character
        local humanoid = pchar and pchar:FindFirstChildWhichIsA("Humanoid")
        local root = pchar and pchar:FindFirstChild("HumanoidRootPart")

        if humanoid and root and localRoot then
            local hp = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
            data.Health.Text = "HP " .. hp .. "%"
            data.Health.TextColor3 = hp > 50 and Color3.fromRGB(0, 255, 0) or (hp > 25 and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 0, 0))
            local dist = (root.Position - localRoot.Position).Magnitude
            data.Dist.Text = math.floor(dist) .. "m"
            if espTeamColorEnabled and player.TeamColor then
                data.Name.TextColor3 = player.TeamColor.Color
            else
                data.Name.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end

ESPTab:CreateToggle({
    Name = "ESP Player (Name + HP + Distance)",
    CurrentValue = false,
    Flag = "espToggle",
    Callback = function(v)
        espEnabled = v
        if v then
            for _, player in pairs(Players:GetPlayers()) do createPlayerBillboard(player) end
            if playerRenderConn then playerRenderConn:Disconnect() end
            playerRenderConn = RunService.RenderStepped:Connect(updateAllPlayers)
            Notify{ Title = "ESP Player", Content = "Enabled", Duration = 2 }
        else
            if playerRenderConn then playerRenderConn:Disconnect(); playerRenderConn = nil end
            clearAllPlayerBillboards()
            Notify{ Title = "ESP Player", Content = "Disabled", Duration = 2 }
        end
    end
})

ESPTab:CreateToggle({
    Name = "ESP Team Color",
    CurrentValue = false,
    Flag = "espTeamColor",
    Callback = function(v)
        espTeamColorEnabled = v
        updateAllPlayers()
    end
})

Players.PlayerAdded:Connect(function(player) if espEnabled then createPlayerBillboard(player) end end)
Players.PlayerRemoving:Connect(function(player) removePlayerBillboard(player) end)

local godBillboards = {}
local godRenderConn = nil
local godNames = { "Ancient God", "Furious God", "Hateful God", "Lonely God", "Miserable God", "Old God", "Sleeping God", "Wealthy God" }

local function clearAllGodBillboards()
    for _, data in pairs(godBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(godBillboards)
end

local function stepGodESP()
    local resources = Workspace:FindFirstChild("Resources")
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not resources or not localRoot then return end

    for _, model in ipairs(resources:GetChildren()) do
        if model:IsA("Model") and table.find(godNames, model.Name) and not godBillboards[model] then
            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if primary then
                local bill = Instance.new("BillboardGui")
                bill.Name = "GodESP"
                bill.Size = UDim2.new(0, 200, 0, 35)
                bill.Adornee = primary
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 3, 0)
                bill.Parent = primary
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundTransparency = 1
                bg.BorderSizePixel = 0
                bg.Parent = bill
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = model.Name .. " (...m)"
                label.TextColor3 = Color3.fromRGB(255, 100, 255)
                label.Font = Enum.Font.SourceSans
                label.TextSize = 18
                label.Parent = bg
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Parent = label
                godBillboards[model] = { Bill = bill, Label = label, Part = primary }
            end
        end
    end

    for model, data in pairs(godBillboards) do
        if not model.Parent then
            if data.Bill then data.Bill:Destroy() end
            godBillboards[model] = nil
        else
            local dist = (data.Part.Position - localRoot.Position).Magnitude
            data.Label.Text = model.Name .. " (" .. math.floor(dist) .. "m)"
        end
    end
end

ESPTab:CreateToggle({
    Name = "ESP God (Resources)",
    CurrentValue = false,
    Flag = "espGodToggle",
    Callback = function(v)
        espGodEnabled = v
        if v then
            if godRenderConn then godRenderConn:Disconnect() end
            godRenderConn = RunService.RenderStepped:Connect(stepGodESP)
            Notify{ Title = "ESP God", Content = "Enabled", Duration = 2 }
        else
            if godRenderConn then godRenderConn:Disconnect(); godRenderConn = nil end
            clearAllGodBillboards()
            Notify{ Title = "ESP God", Content = "Disabled", Duration = 2 }
        end
    end
})

local oreDisplayToOriginal = {
    ["Rich Adurite"] = "Adurite Rich Rock",
    ["Adurite"] = "Adurite Rock",
    ["Coal"] = "Coal Node",
    ["Gold"] = "Gold Node",
    ["Iron"] = "Iron Node",
    ["Stone"] = "Stone Node",
    ["Emerald"] = "Emerald Lode",
    ["Crystal"] = "Crystal Lode"
}
local oreDisplayNames = {"Rich Adurite", "Adurite", "Coal", "Gold", "Iron", "Stone", "Emerald", "Crystal"}
local selectedOres = { "Rich Adurite", "Adurite" }

ESPTab:CreateDropdown({
    Name = "Ore Selection (Multi)",
    Options = oreDisplayNames,
    CurrentValue = { "Rich Adurite", "Adurite" },
    MultiSelect = true,
    Flag = "oreDropdown",
    Callback = function(value)
        selectedOres = value
    end
})

local oreBillboards = {}
local oreRenderConn = nil

local function clearAllOreBillboards()
    for _, data in pairs(oreBillboards) do
        if data.Bill then data.Bill:Destroy() end
    end
    table.clear(oreBillboards)
end

local function stepOreESP()
    if #selectedOres == 0 then clearAllOreBillboards(); return end
    local resources = Workspace:FindFirstChild("Resources")
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not resources or not localRoot then return end

    local targetOriginalNames = {}
    for _, displayName in ipairs(selectedOres) do
        local original = oreDisplayToOriginal[displayName]
        if original then targetOriginalNames[original] = true end
    end

    for _, model in ipairs(resources:GetChildren()) do
        if model:IsA("Model") and targetOriginalNames[model.Name] and not oreBillboards[model] then
            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if primary then
                local displayName = model.Name
                for d, o in pairs(oreDisplayToOriginal) do
                    if o == model.Name then displayName = d; break end
                end
                local bill = Instance.new("BillboardGui")
                bill.Name = "OreESP"
                bill.Size = UDim2.new(0, 200, 0, 35)
                bill.Adornee = primary
                bill.AlwaysOnTop = true
                bill.StudsOffset = Vector3.new(0, 2, 0)
                bill.Parent = primary
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundTransparency = 1
                bg.BorderSizePixel = 0
                bg.Parent = bill
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = displayName .. " (...m)"
                label.TextColor3 = Color3.fromRGB(255, 215, 0)
                label.Font = Enum.Font.SourceSans
                label.TextSize = 18
                label.Parent = bg
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Parent = label
                oreBillboards[model] = { Bill = bill, Label = label, DisplayName = displayName, Part = primary }
            end
        end
    end

    for model, data in pairs(oreBillboards) do
        if not model.Parent or not targetOriginalNames[model.Name] then
            if data.Bill then data.Bill:Destroy() end
            oreBillboards[model] = nil
        else
            local dist = (data.Part.Position - localRoot.Position).Magnitude
            data.Label.Text = data.DisplayName .. " (" .. math.floor(dist) .. "m)"
        end
    end
end

ESPTab:CreateToggle({
    Name = "ESP Ore",
    CurrentValue = false,
    Flag = "espOreToggle",
    Callback = function(v)
        espOreEnabled = v
        if v then
            if oreRenderConn then oreRenderConn:Disconnect() end
            oreRenderConn = RunService.RenderStepped:Connect(stepOreESP)
            Notify{ Title = "ESP Ore", Content = "Enabled", Duration = 2 }
        else
            if oreRenderConn then oreRenderConn:Disconnect(); oreRenderConn = nil end
            clearAllOreBillboards()
            Notify{ Title = "ESP Ore", Content = "Disabled", Duration = 2 }
        end
    end
})

-- =============================================
-- TAB 3: AUTO FARM
-- =============================================

-- ======= SECTION 1: ICE CHUNK =======
AutoFarmTab:CreateSection("Ice Chunk Farm")

local autoChunkEnabled = false
local autoClickEnabled = false
local autoPickupEnabled = false
local chunkDistance = 5
local clickPositionMode = "Center"
local autoClickInterval = 0.1 -- Default click interval (speed)
local zonePart = nil
local processing = false
local originalCFrame = nil
local currentTween = nil
local isTweening = false
local chunkMonitorTask = nil
local clickTask = nil
local pickupTask = nil

-- Click indicator dot
local clickDot = nil

local function updateClickDotPosition()
    if not clickDot then return end
    local vp = Workspace.CurrentCamera.ViewportSize
    local centerX = vp.X / 2
    local centerY = vp.Y / 2
    if clickPositionMode == "Top Center" then
        centerY = 50
    end
    clickDot.Dot.Position = UDim2.new(0, centerX - 5, 0, centerY - 5)
end

local function createClickDot()
    if clickDot then return end
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ClickDotGui"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999999
    screenGui.Parent = LocalPlayer.PlayerGui

    local dot = Instance.new("Frame")
    dot.Name = "ClickDot"
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    dot.BackgroundTransparency = 0.3
    dot.BorderSizePixel = 0
    dot.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.5
    stroke.Parent = dot

    clickDot = {Gui = screenGui, Dot = dot}
    updateClickDotPosition()
end

local function removeClickDot()
    if clickDot then
        if clickDot.Gui then clickDot.Gui:Destroy() end
        clickDot = nil
    end
end

local function createZone()
    if zonePart then return end
    zonePart = Instance.new("Part")
    zonePart.Name = "IceChunkZone"
    zonePart.Size = Vector3.new(90, 30, 80)
    zonePart.Position = Vector3.new(940, -2, -1411)
    zonePart.Transparency = 1
    zonePart.CanCollide = false
    zonePart.Anchored = true
    zonePart.Parent = Workspace
end

local function destroyZone()
    if zonePart then zonePart:Destroy(); zonePart = nil end
end

local function isPlayerInZone()
    if not zonePart then return false end
    local currentChar = LocalPlayer.Character
    local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local zonePos = zonePart.Position
    local zoneSize = zonePart.Size
    local playerPos = hrp.Position
    local halfX = zoneSize.X / 2
    local halfY = zoneSize.Y / 2
    local halfZ = zoneSize.Z / 2
    return math.abs(playerPos.X - zonePos.X) <= halfX and math.abs(playerPos.Y - zonePos.Y) <= halfY and math.abs(playerPos.Z - zonePos.Z) <= halfZ
end

local function findIceChunkInZone()
    if not zonePart then return nil end
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Include
    local resources = Workspace:FindFirstChild("Resources")
    if not resources then return nil end
    overlapParams.FilterDescendantsInstances = {resources}
    local partsInZone = Workspace:GetPartsInPart(zonePart, overlapParams)
    for _, part in ipairs(partsInZone) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model.Name == "Ice Chunk" then return model end
    end
    return nil
end

local function tweenToCFrame(targetCFrame)
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local dist = (rootPart.Position - targetCFrame.Position).Magnitude
    if dist < 0.5 then return end
    local tweenInfo = TweenInfo.new(dist / 16, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    currentTween = tween
    isTweening = true
    tween:Play()
    tween.Completed:Wait()
    currentTween = nil
    isTweening = false
end

local function tweenPlayerToTarget(model)
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    originalCFrame = rootPart.CFrame
    local modelPos = model:GetPivot().Position
    local currentPos = rootPart.Position
    local dir = (currentPos - modelPos).Magnitude > 0 and (currentPos - modelPos).Unit or Vector3.new(0, 0, 1)
    local targetPos = modelPos + dir * chunkDistance
    local targetCFrame = CFrame.new(targetPos, modelPos)
    tweenToCFrame(targetCFrame)
end

local function tweenBack()
    if not originalCFrame then return end
    tweenToCFrame(originalCFrame)
    originalCFrame = nil
end

local function monitorIceChunk()
    if processing or isTweening then return end
    if not isPlayerInZone() then return end
    processing = true
    local model = findIceChunkInZone()
    if model then
        tweenPlayerToTarget(model)
        repeat task.wait(0.5) until not model.Parent or not autoChunkEnabled or not isPlayerInZone()
        if autoChunkEnabled and isPlayerInZone() then tweenBack() end
    end
    processing = false
end

local function doAutoClick()
    local vp = Workspace.CurrentCamera.ViewportSize
    local inset = GuiService:GetGuiInset()
    local centerX = vp.X / 2
    local centerY = (vp.Y / 2) + inset.Y
    if clickPositionMode == "Top Center" then
        centerY = inset.Y + 50
    end

    -- Hide dot briefly so click passes through
    if clickDot and clickDot.Dot then
        clickDot.Dot.Visible = false
    end

    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)

    if clickDot and clickDot.Dot then
        clickDot.Dot.Visible = true
    end
end

local function createPickupBuffer(entityID)
    local b = buffer.create(6)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, 59)
    buffer.writeu32(b, 2, entityID)
    return b
end

local function sendPickup(entityID)
    local remote = getByteNetRemote()
    if not remote then return false end
    local b = createPickupBuffer(entityID)
    pcall(function() remote:FireServer(b, nil) end)
    return true
end

local function autoPickupLoop()
    while autoPickupEnabled do
        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.5); continue end
        local itemsFolder = Workspace:FindFirstChild("Items")
        if not itemsFolder then task.wait(0.5); continue end
        for _, obj in ipairs(itemsFolder:GetChildren()) do
            if not autoPickupEnabled then break end
            local entityID = obj:GetAttribute("EntityID") or tonumber(obj.Name)
            if not entityID then continue end
            local pos
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary then pos = primary.Position end
            end
            if not pos then continue end
            if (pos - hrp.Position).Magnitude <= 30 then
                sendPickup(entityID)
                task.wait(0.05)
            end
        end
        task.wait(0.2)
    end
end

AutoFarmTab:CreateToggle({
    Name = "Auto Ice Chunk (Zone required)",
    CurrentValue = false,
    Flag = "autoChunkToggle",
    Callback = function(v)
        autoChunkEnabled = v
        if v then
            createZone()
            if chunkMonitorTask then task.cancel(chunkMonitorTask) end
            chunkMonitorTask = task.spawn(function()
                while autoChunkEnabled do
                    if not processing and not isTweening then monitorIceChunk() end
                    task.wait(1)
                end
            end)
            Notify{ Title = "Auto Ice Chunk", Content = "Enabled", Duration = 2 }
        else
            destroyZone()
            if currentTween then currentTween:Cancel(); currentTween = nil end
            if chunkMonitorTask then task.cancel(chunkMonitorTask); chunkMonitorTask = nil end
            isTweening = false
            originalCFrame = nil
            processing = false
            Notify{ Title = "Auto Ice Chunk", Content = "Disabled", Duration = 2 }
        end
    end
})

AutoFarmTab:CreateSlider({
    Name = "Chunk Distance",
    Range = {2, 20},
    Increment = 1,
    CurrentValue = 5,
    Flag = "chunkDistanceSlider",
    Callback = function(v) chunkDistance = v end
})

local autoClickToggleObj
autoClickToggleObj = AutoFarmTab:CreateToggle({
    Name = "Auto Click",
    CurrentValue = false,
    Flag = "autoClickToggle",
    Callback = function(v)
        autoClickEnabled = v
        if v then
            if clickTask then task.cancel(clickTask) end
            createClickDot()
            clickTask = task.spawn(function()
                while autoClickEnabled do
                    doAutoClick()
                    task.wait(autoClickInterval) -- Speed interval adjusted dynamically
                end
            end)
            Notify{ Title = "Auto Click", Content = "Enabled", Duration = 2 }
        else
            if clickTask then task.cancel(clickTask); clickTask = nil end
            removeClickDot()
            Notify{ Title = "Auto Click", Content = "Disabled", Duration = 2 }
        end
    end
})

-- Adjustable interval (speed) for auto clicking
AutoFarmTab:CreateSlider({
    Name = "Click Interval (Speed)",
    Range = {0.01, 1},
    Increment = 0.01,
    Suffix = "s",
    CurrentValue = 0.1,
    Flag = "clickSpeedSlider",
    Callback = function(v)
        autoClickInterval = v
    end
})

AutoFarmTab:CreateDropdown({
    Name = "Click Position",
    Options = {"Center", "Top Center"},
    CurrentValue = "Center",
    MultiSelect = false,
    Flag = "clickPositionDropdown",
    Callback = function(value)
        if type(value) == "table" then
            clickPositionMode = value[1] or "Center"
        else
            clickPositionMode = value
        end
        updateClickDotPosition()
    end
})

-- Hotkey system
local autoClickHotkey = Enum.KeyCode.J
local listeningForHotkey = false

local hotkeyButtonObj
hotkeyButtonObj = AutoFarmTab:CreateButton({
    Name = "Auto Click Hotkey: J (Click to change)",
    Callback = function()
        listeningForHotkey = true
        Notify{ Title = "Hotkey", Content = "Press any key to set hotkey", Duration = 3 }
    end
})

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if listeningForHotkey then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            autoClickHotkey = input.KeyCode
            listeningForHotkey = false
            pcall(function()
                hotkeyButtonObj:Set("Auto Click Hotkey: " .. autoClickHotkey.Name .. " (Click to change)")
            end)
            Notify{ Title = "Hotkey", Content = "Set to " .. autoClickHotkey.Name, Duration = 2 }
        end
        return
    end

    if input.KeyCode == autoClickHotkey then
        local newState = not autoClickEnabled
        pcall(function()
            autoClickToggleObj:Set(newState)
        end)
    end
end)

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    updateClickDotPosition()
end)

AutoFarmTab:CreateToggle({
    Name = "Auto Pickup Items",
    CurrentValue = false,
    Flag = "autoPickupToggle",
    Callback = function(v)
        autoPickupEnabled = v
        if v then
            if pickupTask then task.cancel(pickupTask) end
            pickupTask = task.spawn(autoPickupLoop)
            Notify{ Title = "Auto Pickup", Content = "Enabled", Duration = 2 }
        else
            if pickupTask then task.cancel(pickupTask); pickupTask = nil end
            Notify{ Title = "Auto Pickup", Content = "Disabled", Duration = 2 }
        end
    end
})

-- ======= SECTION 2: FRUIT FARM =======
AutoFarmTab:CreateSection("Fruit Farm")

local fruits = {
    Bloodfruit = 94, Bluefruit = 377, Lemon = 99, Coconut = 1,
    Jelly = 604, Banana = 606, Orange = 602, Oddberry = 32,
    Berry = 35, Strangefruit = 302, Strawberry = 282,
    Sunfruit = 128, Pumpkin = 80, ["Prickly Pear"] = 378,
    Apple = 243, Barley = 247, Cloudberry = 101, Carrot = 147
}
local fruitNames = {"Bloodfruit", "Bluefruit", "Lemon", "Coconut", "Jelly", "Banana", "Orange", "Oddberry", "Berry", "Strangefruit", "Strawberry", "Sunfruit", "Pumpkin", "Prickly Pear", "Apple", "Barley", "Cloudberry", "Carrot"}

local pickFruitEnabled = false
local plantFruitEnabled = false
local pickFruitRange = 15
local plantFruitRange = 15
local selectedFruit = "Bloodfruit"
local pickFruitTask = nil
local plantFruitTask = nil

local fruitTweenEnabled = false
local fruitTweenTask = nil
local fruitTweenObj = nil
local fruitHomePosition = nil
local fruitScanRadius = 200
local fruitStandDistance = 3

local function createPickFruitBuffer(entityID)
    local b = buffer.create(6)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, 59)
    buffer.writeu32(b, 2, entityID)
    return b
end

local function createPlantFruitBuffer(entityID, fruitID)
    local b = buffer.create(8)
    buffer.writeu8(b, 0, 0)
    buffer.writeu8(b, 1, 96)
    buffer.writeu32(b, 2, entityID)
    buffer.writeu16(b, 6, fruitID)
    return b
end

local function sendPickFruit(entityID)
    local event = getByteNetRemote()
    if not event then return false end
    pcall(function() event:FireServer(createPickFruitBuffer(entityID), nil) end)
    return true
end

local function sendPlantFruit(entityID, fruitID)
    local event = getByteNetRemote()
    if not event then return false end
    pcall(function() event:FireServer(createPlantFruitBuffer(entityID, fruitID), nil) end)
    return true
end

local function pickFruitLoop()
    while pickFruitEnabled do
        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local cropsFolder = Workspace:FindFirstChild("Crops")
        if hrp and cropsFolder then
            for _, item in ipairs(cropsFolder:GetChildren()) do
                if not pickFruitEnabled then break end
                local entityID = item:GetAttribute("EntityID")
                if entityID then
                    local primary = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
                    if primary and (primary.Position - hrp.Position).Magnitude <= pickFruitRange then
                        sendPickFruit(entityID)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function plantFruitLoop()
    while plantFruitEnabled do
        local currentChar = LocalPlayer.Character
        local hrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        local deployables = Workspace:FindFirstChild("Deployables")
        if hrp and deployables then
            local fruitID = fruits[selectedFruit] or 94
            for _, model in ipairs(deployables:GetChildren()) do
                if not plantFruitEnabled then break end
                if model:IsA("Model") and model.Name == "Plant Box" then
                    if not model:FindFirstChild("Seed") then
                        local entityID = model:GetAttribute("EntityID")
                        if entityID and entityID > 0 then
                            local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                            if primary and (primary.Position - hrp.Position).Magnitude <= plantFruitRange then
                                sendPlantFruit(entityID, fruitID)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.15)
    end
end

-- Fruit tween system
local function fruitTweenTo(targetCFrame)
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    local dist = (rootPart.Position - targetCFrame.Position).Magnitude
    if dist < 0.5 then return true end

    local tweenInfo = TweenInfo.new(dist / 16, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    fruitTweenObj = tween

    tween:Play()
    tween.Completed:Wait()

    fruitTweenObj = nil
    return true
end

local function fruitTweenToPart(modelPart, standDist)
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local modelPos = modelPart.Position
    local currentPos = rootPart.Position
    local dir = (currentPos - modelPos).Magnitude > 0 and (currentPos - modelPos).Unit or Vector3.new(0, 0, 1)
    local targetPos = modelPos + dir * standDist
    local targetCFrame = CFrame.new(targetPos, modelPos)

    return fruitTweenTo(targetCFrame)
end

local function findEmptyBoxes(hrpPos)
    local results = {}
    local deployables = Workspace:FindFirstChild("Deployables")
    if not deployables then return results end

    for _, model in ipairs(deployables:GetChildren()) do
        if model:IsA("Model") and model.Name == "Plant Box" then
            if not model:FindFirstChild("Seed") then
                local entityID = model:GetAttribute("EntityID")
                if entityID and entityID > 0 then
                    local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = (primary.Position - hrpPos).Magnitude
                        if dist <= fruitScanRadius then
                            table.insert(results, {
                                Type = "box",
                                Ref = model,
                                Part = primary,
                                Distance = dist
                            })
                        end
                    end
                end
            end
        end
    end

    return results
end

local function findCrops(hrpPos)
    local results = {}
    local cropsFolder = Workspace:FindFirstChild("Crops")
    if not cropsFolder then return results end

    for _, item in ipairs(cropsFolder:GetChildren()) do
        local entityID = item:GetAttribute("EntityID")
        if entityID then
            local primary
            if item:IsA("BasePart") then
                primary = item
            elseif item:IsA("Model") then
                primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
            end
            if primary then
                local dist = (primary.Position - hrpPos).Magnitude
                if dist <= fruitScanRadius then
                    table.insert(results, {
                        Type = "crop",
                        Ref = item,
                        Part = primary,
                        Distance = dist
                    })
                end
            end
        end
    end

    return results
end

local function buildTargetQueue()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end

    local playerPos = hrp.Position
    local queue = {}

    local boxes = findEmptyBoxes(playerPos)
    for _, box in ipairs(boxes) do
        table.insert(queue, box)
    end

    local crops = findCrops(playerPos)
    for _, crop in ipairs(crops) do
        table.insert(queue, crop)
    end

    table.sort(queue, function(a, b)
        return a.Distance < b.Distance
    end)

    return queue
end

local function isTargetValid(target)
    if not target.Ref or not target.Ref.Parent then return false end
    if not target.Part or not target.Part.Parent then return false end

    if target.Type == "box" then
        if target.Ref:FindFirstChild("Seed") then return false end
    end

    return true
end

local function fruitTweenLoop()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    fruitHomePosition = hrp.CFrame

    while fruitTweenEnabled do
        if not LocalPlayer.Character then task.wait(0.5); continue end
        hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.5); continue end

        local queue = buildTargetQueue()

        if #queue == 0 then
            task.wait(1)
            continue
        end

        for _, target in ipairs(queue) do
            if not fruitTweenEnabled then break end

            if isTargetValid(target) then
                fruitTweenToPart(target.Part, fruitStandDistance)

                if not fruitTweenEnabled then break end

                local waitStart = tick()
                while fruitTweenEnabled and tick() - waitStart < 0.5 do
                    if not isTargetValid(target) then break end
                    task.wait(0.05)
                end
            end

            if not fruitTweenEnabled then break end
        end

        if not fruitTweenEnabled then break end

        local newQueue = buildTargetQueue()
        if #newQueue == 0 then
            if fruitHomePosition and fruitTweenEnabled then
                fruitTweenTo(fruitHomePosition)
            end
            task.wait(2)
        else
            task.wait(0.3)
        end
    end

    if fruitHomePosition and LocalPlayer.Character then
        local hrpCheck = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrpCheck then
            fruitTweenTo(fruitHomePosition)
        end
    end

    fruitHomePosition = nil
end

local pickFruitToggleObj
pickFruitToggleObj = AutoFarmTab:CreateToggle({
    Name = "Auto Pick Fruit",
    CurrentValue = false,
    Flag = "pickFruitToggle",
    Callback = function(v)
        pickFruitEnabled = v
        if pickFruitTask then task.cancel(pickFruitTask); pickFruitTask = nil end
        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Pick Fruit", Content = "Disabled", Duration = 2 }
                pickFruitToggleObj:Set(false)
                return
            end
            pickFruitTask = task.spawn(pickFruitLoop)
            Notify{ Title = "Auto Pick Fruit", Content = "Enabled", Duration = 2 }
        else
            Notify{ Title = "Auto Pick Fruit", Content = "Disabled", Duration = 2 }
        end
    end
})

AutoFarmTab:CreateSlider({
    Name = "Pick Fruit Range",
    Range = {1, 30},
    Increment = 1,
    CurrentValue = 15,
    Flag = "pickFruitRangeSlider",
    Callback = function(v) pickFruitRange = v end
})

AutoFarmTab:CreateDropdown({
    Name = "Select Fruit to Plant",
    Options = fruitNames,
    CurrentValue = "Bloodfruit",
    MultiSelect = false,
    Flag = "fruitDropdown",
    Callback = function(value)
        if type(value) == "table" then
            selectedFruit = value[1] or "Bloodfruit"
        else
            selectedFruit = value
        end
    end
})

local plantFruitToggleObj
plantFruitToggleObj = AutoFarmTab:CreateToggle({
    Name = "Auto Plant Box",
    CurrentValue = false,
    Flag = "plantFruitToggle",
    Callback = function(v)
        plantFruitEnabled = v
        if plantFruitTask then task.cancel(plantFruitTask); plantFruitTask = nil end
        if v then
            if not getByteNetRemote() then
                Notify{ Title = "Auto Plant Box", Content = "Disabled", Duration = 2 }
                plantFruitToggleObj:Set(false)
                return
            end
            plantFruitTask = task.spawn(plantFruitLoop)
            Notify{ Title = "Auto Plant Box", Content = "Enabled", Duration = 2 }
        else
            Notify{ Title = "Auto Plant Box", Content = "Disabled", Duration = 2 }
        end
    end
})

AutoFarmTab:CreateSlider({
    Name = "Plant Box Range",
    Range = {1, 30},
    Increment = 1,
    CurrentValue = 15,
    Flag = "plantFruitRangeSlider",
    Callback = function(v) plantFruitRange = v end
})

local fruitTweenToggleObj
fruitTweenToggleObj = AutoFarmTab:CreateToggle({
    Name = "Tween to Box and Crop (200 studs)",
    CurrentValue = false,
    Flag = "fruitTweenToggle",
    Callback = function(v)
        fruitTweenEnabled = v

        if fruitTweenTask then
            task.cancel(fruitTweenTask)
            fruitTweenTask = nil
        end

        if v then
            if fruitTweenObj then
                fruitTweenObj:Cancel()
                fruitTweenObj = nil
            end
            fruitTweenTask = task.spawn(fruitTweenLoop)
            Notify{ Title = "Tween Fruit Farm", Content = "Enabled", Duration = 2 }
        else
            if fruitTweenObj then
                fruitTweenObj:Cancel()
                fruitTweenObj = nil
            end
            Notify{ Title = "Tween Fruit Farm", Content = "Disabled", Duration = 2 }
        end
    end
})

